<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'FAMSWORLD - Store' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

  <% 
    const user = locals.currentUser || null;
    const wishlist = locals.wishlistItems || [];
    const cart = locals.cartItems || [];
  %>

  <!-- Main Navbar -->
  <nav x-data="{ shopOpen: false, searchOpen: false, profileOpen: false, wishlistOpen: false, cartOpen: false }" class="bg-white shadow-sm sticky top-0 z-50">
    <div class="py-4 px-8 flex justify-between items-center border-b max-w-7xl mx-auto">
      
      <!-- Logo -->
      <a href="/" class="text-2xl font-black tracking-wider text-slate-900">
        <span class="text-orange-500">FAM</span>SWORLD
      </a>
      
      <!-- Nav Links -->
      <div class="hidden md:flex gap-8 text-xs font-bold tracking-wide items-center">
        <a href="/" class="text-orange-500">HOME</a>
        <a href="/products" class="hover:text-orange-500">SHOP ALL</a>
        <a href="/products?sort=bestsellers" class="hover:text-orange-500">BEST SELLERS</a>
        <a href="/products?sort=new" class="hover:text-orange-500">NEW ARRIVALS</a>
        <a href="/about" class="hover:text-orange-500">ABOUT US</a>
      </div>

      <!-- Action Icons -->
      <div class="flex items-center gap-6 text-slate-700 text-lg">
        
        <!-- Search Drawer -->
        <div class="relative py-2" @mouseenter="searchOpen = true" @mouseleave="searchOpen = false">
          <button class="hover:text-orange-500">🔍</button>
          <div x-show="searchOpen" x-cloak x-transition class="absolute right-0 top-full w-72 bg-white p-3 border shadow-xl rounded-md z-50">
            <form action="/products/search" method="GET" class="flex items-center border rounded px-2 py-1 bg-gray-50">
              <input type="text" name="q" placeholder="Search products..." class="w-full text-xs bg-transparent focus:outline-none">
              <button type="submit" class="text-xs text-orange-500 font-bold px-1">Search</button>
            </form>
          </div>
        </div>

        <!-- Profile Dropdown -->
        <div class="relative">
          <button @click="profileOpen = !profileOpen" class="hover:text-orange-500">👤</button>
          <div x-show="profileOpen" @click.outside="profileOpen = false" x-cloak x-transition class="absolute right-0 mt-2 w-52 bg-white border shadow-lg rounded-md py-2 z-50">
            <% if (user) { %>
              <div class="px-4 py-2 border-b">
                <p class="text-xs font-bold text-slate-900"><%= user.name || 'User' %></p>
                <p class="text-[10px] text-gray-400"><%= user.email %></p>
              </div>
              <a href="/users/profile" class="block px-4 py-2 text-xs hover:bg-gray-100">My Profile</a>
              <a href="/users/orders" class="block px-4 py-2 text-xs hover:bg-gray-100">My Orders</a>
              <hr class="my-1">
              <a href="/users/logout" class="block px-4 py-2 text-xs text-red-500 hover:bg-red-50">Logout</a>
            <% } else { %>
              <div class="p-3 text-center">
                <p class="text-xs text-gray-500 mb-2">Welcome to FAMSWORLD</p>
                <a href="/users/login" class="block w-full bg-orange-500 text-white font-bold text-xs py-1.5 rounded mb-1 hover:bg-orange-600">Login</a>
                <a href="/users/register" class="block w-full border text-slate-800 font-bold text-xs py-1.5 rounded hover:bg-gray-50">Register</a>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Wishlist -->
        <div class="relative">
          <button @click="wishlistOpen = !wishlistOpen" class="hover:text-orange-500 relative">
            ❤️
            <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[9px] rounded-full h-4 w-4 flex items-center justify-center font-bold">
              <%= wishlist.length %>
            </span>
          </button>
        </div>

        <!-- Cart Badge -->
        <div class="relative">
          <a href="/cart" class="hover:text-orange-500 relative">
            🛒
            <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[9px] rounded-full h-4 w-4 flex items-center justify-center font-bold">
              <%= cart.length %>
            </span>
          </a>
        </div>

      </div>
    </div>
  </nav>