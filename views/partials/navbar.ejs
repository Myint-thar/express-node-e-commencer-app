<nav class="w-full bg-white border-b border-gray-100 px-8 py-4 flex items-center justify-between relative z-40">
  
  <!-- Logo -->
  <a href="/" class="text-2xl font-black tracking-tight text-black">
    Stuffsus
  </a>

  <!-- Menu Links (Route လမ်းကြောင်းများ ပြင်ဆင်ပြီး) -->
  <div class="hidden md:flex items-center gap-1 bg-gray-50 p-1.5 rounded-full border border-gray-100">
    <a href="/" class="text-xs font-bold <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'text-black bg-white shadow-xs' : 'text-gray-500 hover:text-black' %> px-4 py-2 rounded-full transition">
      Tech Hub
    </a>
    <a href="/brands" class="text-xs font-bold <%= (typeof activePage !== 'undefined' && activePage === 'brands') ? 'text-black bg-white shadow-xs' : 'text-gray-500 hover:text-black' %> px-4 py-2 rounded-full transition">
      Brands
    </a>
    <a href="/blog" class="text-xs font-bold <%= (typeof activePage !== 'undefined' && activePage === 'blog') ? 'text-black bg-white shadow-xs' : 'text-gray-500 hover:text-black' %> px-4 py-2 rounded-full transition">
      Blog
    </a>
  </div>

  <!-- Right Side (Cart & User Menu) -->
  <div class="flex items-center gap-4">
    <% if (isLoggedIn && currentUser) { %>
      <!-- Cart Link -->
      <a href="/cart" class="text-xs font-bold text-gray-700 hover:text-black flex items-center gap-1.5 border border-gray-200 px-3.5 py-2 rounded-full hover:border-black transition">
        <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span>Cart</span>
      </a>

      <!-- Profile Dropdown Container -->
      <div class="relative inline-block text-left">
        <button id="userMenuBtn" type="button" class="flex items-center gap-2.5 focus:outline-none p-1.5 pr-3 rounded-full hover:bg-gray-100 transition border border-gray-200 cursor-pointer">
          <% if (currentUser.avatar) { %>
            <img src="<%= currentUser.avatar %>" alt="Avatar" class="w-7 h-7 rounded-full object-cover">
          <% } else { %>
            <div class="w-7 h-7 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs">
              <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
            </div>
          <% } %>

          <span class="text-xs font-bold text-gray-800"><%= currentUser.name %></span>
          
          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Box -->
        <div id="userMenuDropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 z-50 transition-all duration-200">
          <div class="px-4 py-2 border-b border-gray-100 mb-1">
            <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Signed in as</p>
            <p class="text-xs font-bold text-gray-900 truncate"><%= currentUser.email %></p>
          </div>

          <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-50 transition">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Dashboard</span>
          </a>

          <a href="/orders" class="flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-50 transition">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span>Orders</span>
          </a>

          <a href="/cart" class="flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-50 transition">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
            </svg>
            <span>My Cart</span>
          </a>

          <div class="border-t border-gray-100 my-1"></div>

          <form action="/logout" method="POST" class="m-0">
            <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-red-500 hover:bg-red-50 transition text-left cursor-pointer">
              <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              <span>Logout</span>
            </button>
          </form>
        </div>
      </div>

    <% } else { %>
      <a href="/login" class="text-xs font-bold text-gray-600 hover:text-black transition px-2 py-1">Sign In</a>
      <a href="/signup" class="text-xs font-bold bg-black text-white px-4 py-2 rounded-full hover:bg-gray-800 transition shadow-xs">Sign Up</a>
    <% } %>
  </div>
</nav>

<script>
  const userBtn = document.getElementById('userMenuBtn');
  const userDropdown = document.getElementById('userMenuDropdown');

  if (userBtn && userDropdown) {
    userBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!userDropdown.contains(e.target) && !userBtn.contains(e.target)) {
        userDropdown.classList.add('hidden');
      }
    });
  }
</script>