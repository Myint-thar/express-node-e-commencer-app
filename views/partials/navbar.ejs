<!-- views/partials/navbar.ejs -->
<header class="bg-white/80 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40 px-6 py-4">
    <div class="max-w-[1200px] mx-auto flex items-center justify-between">
        <!-- Logo (Tech Hub / Home သို့ ချိတ်ဆက်ထားသည်) -->
        <a href="/" class="text-2xl font-black tracking-tighter text-black">Stuffsus</a>
        
        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="/" 
               class="text-xs font-bold transition <%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'text-black border-b-2 border-black pb-0.5' : 'text-gray-600 hover:text-black' %>">
               Tech Hub
            </a>
            <a href="/brands" 
               class="text-xs font-bold transition <%= (typeof activePage !== 'undefined' && activePage === 'brands') ? 'text-black border-b-2 border-black pb-0.5' : 'text-gray-600 hover:text-black' %>">
               Brands
            </a>
            <a href="/blog" 
               class="text-xs font-bold transition <%= (typeof activePage !== 'undefined' && activePage === 'blog') ? 'text-black border-b-2 border-black pb-0.5' : 'text-gray-600 hover:text-black' %>">
               Blog
            </a>
        </nav>

        <!-- Right Side Actions (Cart & Profile) -->
        <div class="flex items-center gap-4">
            <!-- Cart Button -->
            <button type="button" 
                    onclick="typeof toggleCartModal === 'function' ? toggleCartModal() : window.location.href='/checkout'" 
                    class="relative p-2.5 bg-gray-100 hover:bg-gray-200 rounded-full transition">
                <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                </svg>
                <!-- Cart Count Badge -->
                <span id="cart-badge" 
                      class="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? '' : 'hidden' %> absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center">
                    <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>
                </span>
            </button>

            <!-- User Profile Avatar -->
            <div class="w-8 h-8 rounded-full bg-gray-200 overflow-hidden border border-gray-100">
                <img src="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.avatar) ? currentUser.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80' %>" 
                     alt="User" 
                     class="w-full h-full object-cover">
            </div>
        </div>
    </div>
</header>