<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-[1400px] mx-auto px-6 py-4 flex items-center justify-between">
    
    <!-- Left: Logo (Stuffsus) -->
    <a href="/" class="flex items-center gap-2">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 22h20L12 2z"/></svg>
      <span class="text-xl font-black text-black tracking-tight">Stuffsus</span>
    </a>

    <!-- Middle: Nav Links  -->
  <div class="hidden md:flex items-center gap-10 text-[13px] font-bold text-gray-400">
      
      <a href="/brands" class="<%= (typeof activePage !== 'undefined' && activePage === 'brands') ? 'text-black font-extrabold pb-2 -mb-2 border-b-2 border-black' : 'hover:text-black transition pb-2 -mb-2' %>">
        Brands
      </a>

      <a href="/" class="<%= (typeof activePage !== 'undefined' && activePage === 'shop') ? 'text-black font-extrabold pb-2 -mb-2 border-b-2 border-black' : 'hover:text-black transition pb-2 -mb-2' %>">
        Tech Hub
      </a>

      <a href="/blog" class="<%= (typeof activePage !== 'undefined' && activePage === 'blog') ? 'text-black font-extrabold pb-2 -mb-2 border-b-2 border-black' : 'hover:text-black transition pb-2 -mb-2' %>">
        Blog
      </a>

    </div>

    <!-- Right: Icons -->
    <div class="flex items-center gap-6 text-black">
      <a href="/cart" class="relative hover:text-gray-600 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        <% if (locals.cartCount > 0) { %>
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 flex items-center justify-center rounded-full">
            <%= cartCount %>
          </span>
        <% } %>
      </a>

      <!-- User Avatar -->
      <a href="/login" class="w-8 h-8 rounded-full bg-gray-200 overflow-hidden border border-gray-300">
        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" class="w-full h-full object-cover">
      </a>
    </div>
  </div>
</header>