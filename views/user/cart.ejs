<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stuffsus - Shopping Cart</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-[#fcfcfc] text-black flex flex-col min-h-screen">

  <%- include('../partials/navbar', { activePage: 'cart' }) %>

  <main class="max-w-[1000px] w-full mx-auto px-6 py-12 flex-grow">
    <div class="mb-8">
      <h1 class="text-3xl font-black tracking-tight">Shopping Cart</h1>
      <p class="text-sm text-gray-500 mt-1">Review your selected items before proceeding to checkout.</p>
    </div>

    <!-- Cart Items Container -->
    <div id="cart-container" class="space-y-4 mb-8">
      <!-- Dynamic JS will inject items here -->
    </div>

    <!-- Cart Summary & Checkout Action -->
    <div id="cart-summary-card" class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm hidden">
      <div class="flex justify-between items-center mb-6 border-b border-gray-100 pb-4">
        <span class="font-bold text-gray-600">Total Amount:</span>
        <span id="cart-total-price" class="text-2xl font-black text-black">$0.00</span>
      </div>
      <div class="flex gap-4">
        <a href="/products" class="w-1/2 py-3.5 border border-gray-200 text-center font-bold text-xs rounded-xl hover:bg-gray-50 transition">Continue Shopping</a>
        <a href="/checkout" class="w-1/2 py-3.5 bg-black text-white text-center font-bold text-xs rounded-xl hover:bg-gray-800 transition shadow-sm">Proceed to Checkout</a>
      </div>
    </div>
  </main>

  <footer class="w-full max-w-[1400px] mx-auto px-6 py-10 border-t border-gray-200 text-sm font-semibold text-gray-500 mt-auto text-center">
    <p>Copyright © 2026 Stuffsus. All Rights Reserved.</p>
  </footer>

  <script>
    function renderUserCart() {
      let cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      const container = document.getElementById('cart-container');
      const summaryCard = document.getElementById('cart-summary-card');
      const totalPriceEl = document.getElementById('cart-total-price');

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-20 bg-white rounded-3xl border border-gray-100 shadow-sm">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 11h14l1 12H4L5 11z"/>
            </svg>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Your cart is empty</h3>
            <p class="text-xs text-gray-400 mb-6">Discover our latest tech items and add them to your cart.</p>
            <a href="/products" class="px-6 py-3 bg-black text-white text-xs font-bold rounded-xl hover:bg-gray-800 transition">Explore Products</a>
          </div>
        `;
        summaryCard.classList.add('hidden');
        return;
      }

      summaryCard.classList.remove('hidden');
      container.innerHTML = '';
      let subtotal = 0;

      cart.forEach((item, index) => {
        subtotal += item.price * item.qty;
        container.innerHTML += `
          <div class="bg-white rounded-2xl border border-gray-100 p-4 flex items-center justify-between gap-4 shadow-xs">
            <div class="flex items-center gap-4">
              <img src="${item.img}" alt="${item.title}" class="w-16 h-16 object-contain bg-gray-50 rounded-xl p-2">
              <div>
                <h4 class="font-bold text-sm text-black">${item.title}</h4>
                <p class="text-xs text-gray-400 font-medium">${item.variant}</p>
                <div class="font-black text-sm text-black mt-1">$${item.price}</div>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="flex items-center border border-gray-200 rounded-xl bg-gray-50 text-xs font-bold">
                <button onclick="changeQty(${index}, -1)" class="px-3 py-2 text-gray-500 hover:text-black">-</button>
                <span class="px-3">${item.qty}</span>
                <button onclick="changeQty(${index}, 1)" class="px-3 py-2 text-gray-500 hover:text-black">+</button>
              </div>
              <button onclick="removeCartItem(${index})" class="text-red-500 hover:text-red-700 font-bold p-2 text-sm">✕</button>
            </div>
          </div>
        `;
      });

      totalPriceEl.innerText = `$${subtotal.toLocaleString()}.00`;
    }

    function changeQty(index, delta) {
      let cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      if (cart[index].qty + delta > 0) {
        cart[index].qty += delta;
      } else {
        cart.splice(index, 1);
      }
      localStorage.setItem('selected_checkout_item', JSON.stringify(cart));
      renderUserCart();
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
    }

    function removeCartItem(index) {
      let cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      cart.splice(index, 1);
      localStorage.setItem('selected_checkout_item', JSON.stringify(cart));
      renderUserCart();
      if (typeof updateNavCartBadge === 'function') updateNavCartBadge();
    }

    document.addEventListener('DOMContentLoaded', renderUserCart);
  </script>
</body>
</html>