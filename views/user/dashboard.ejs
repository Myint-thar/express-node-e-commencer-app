<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Dashboard</title>
  <!-- Tailwind CSS CDN Script -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans min-h-screen">

  <!-- Navbar -->
  <%- include('../partials/navbar') %>

  <!-- Main Content Container -->
  <div class="max-w-5xl mx-auto py-10 px-6">
    <h1 class="text-3xl font-black mb-6">User Dashboard</h1>
    
    <div class="bg-white border border-gray-200 p-6 rounded-2xl mb-6 shadow-sm">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Welcome back,</p>
      <p class="text-xl font-bold text-gray-800"><%= currentUser ? currentUser.name : 'User' %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/orders" class="p-6 bg-white border border-gray-200 rounded-2xl hover:border-black transition shadow-sm block">
        <h2 class="text-lg font-bold flex items-center gap-2">📦 My Orders</h2>
        <p class="text-xs text-gray-500 mt-1">View and track your previous purchases.</p>
      </a>

      <a href="/cart" class="p-6 bg-white border border-gray-200 rounded-2xl hover:border-black transition shadow-sm block">
        <h2 class="text-lg font-bold flex items-center gap-2">🛒 Shopping Cart</h2>
        <p class="text-xs text-gray-500 mt-1">Check items in your cart.</p>
      </a>
    </div>
  </div>

</body>
</html>