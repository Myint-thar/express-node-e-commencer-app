<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stuffsus - User Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-[#fcfcfc] text-black flex flex-col min-h-screen">

  <%- include('../partials/navbar', { activePage: 'dashboard' }) %>
  
  <main class="max-w-[1200px] w-full mx-auto px-6 py-10 flex-grow">
    
    <!-- 1. Welcome Banner -->
    <div class="bg-black text-white rounded-3xl p-8 md:p-10 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-xl relative overflow-hidden">
      <div>
        <span class="text-xs uppercase tracking-widest text-gray-400 font-bold mb-1 block">Welcome Back</span>
        <h1 class="text-3xl md:text-4xl font-black"><%= currentUser?.name || 'User' %></h1>
        <p class="text-gray-400 text-xs md:text-sm mt-1"><%= currentUser?.email || 'user@gmail.com' %></p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/products" class="px-5 py-3 bg-white text-black text-xs font-bold rounded-xl hover:bg-gray-100 transition shadow">Browse Store</a>
        <form action="/logout" method="POST">
          <button type="submit" class="px-5 py-3 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white text-xs font-bold rounded-xl transition">Logout</button>
        </form>
      </div>
    </div>

    <!-- 2. Stats Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div>
          <span class="text-xs text-gray-400 font-bold uppercase">Total Orders</span>
          <h3 class="text-xl font-black text-black">0 Orders</h3>
        </div>
      </div>
      
      <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div>
          <span class="text-xs text-gray-400 font-bold uppercase">Cart Items</span>
          <h3 id="dash-cart-count" class="text-xl font-black text-black">0 Items</h3>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div>
          <span class="text-xs text-gray-400 font-bold uppercase">Account Status</span>
          <h3 class="text-xl font-black text-emerald-600">Active</h3>
        </div>
      </div>
    </div>

    <!-- 3. Quick Navigation Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/cart" class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition flex items-center justify-between group">
        <div class="flex items-center gap-4">
          <div>
            <h4 class="font-extrabold text-base text-black">Shopping Cart</h4>
            <p class="text-xs text-gray-400 mt-0.5">Check items in your cart & proceed to checkout.</p>
          </div>
        </div>
        <span class="text-gray-400 group-hover:translate-x-1 transition font-bold text-lg">→</span>
      </a>

      <a href="/orders" class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition flex items-center justify-between group">
        <div class="flex items-center gap-4">
          <div>
            <h4 class="font-extrabold text-base text-black">My Orders & Tracking</h4>
            <p class="text-xs text-gray-400 mt-0.5">View order history and track previous purchases.</p>
          </div>
        </div>
        <span class="text-gray-400 group-hover:translate-x-1 transition font-bold text-lg">→</span>
      </a>
    </div>

  </main>

  <footer class="w-full max-w-[1200px] mx-auto px-6 py-10 border-t border-gray-200 text-sm font-semibold text-gray-500 mt-auto text-center">
    <p>Copyright © 2026 Stuffsus. All Rights Reserved.</p>
  </footer>

  <!-- Script to Sync Cart Count -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      const totalQty = cart.reduce((sum, item) => sum + (item.qty || 1), 0);
      const cartCountEl = document.getElementById('dash-cart-count');
      if (cartCountEl) {
        cartCountEl.innerText = `${totalQty} Item(s)`;
      }
    });
  </script>

</body>
</html>