<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stuffsus - Blog</title>
  <!-- Tailwind CSS မဖြစ်မနေ ထည့်ပေးရပါမယ် -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#fcfcfc] text-black min-h-screen flex flex-col">

  <!-- Navbar -->
  <%- include('partials/navbar', { activePage: 'blog' }) %>

  <!-- Blog Page Content -->
  <main class="flex-grow max-w-[1400px] w-full mx-auto px-6 py-20">
    <div class="text-center mb-16">
      <h1 class="text-5xl md:text-7xl font-black text-black tracking-tight">Tech Blog</h1>
      <p class="mt-4 text-gray-500 font-medium">Read our latest news, reviews, and tips.</p>
    </div>

    <!-- Sample Blog Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1 -->
      <div class="bg-white border border-gray-100 rounded-3xl p-6 hover:shadow-xl transition-shadow cursor-pointer group">
        <div class="w-full h-48 bg-gray-200 rounded-2xl mb-4 overflow-hidden">
           <img src="https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&q=80&w=600" alt="Tech" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
        </div>
        <span class="text-xs font-bold text-red-500 mb-2 block">Tech News</span>
        <h2 class="text-lg font-bold text-black mb-2 group-hover:text-gray-600 transition">The Future of Minimalist Tech</h2>
        <p class="text-sm text-gray-500">Discover how modern design is shaping the way we use everyday gadgets.</p>
      </div>
      
      <!-- Card 2 -->
      <div class="bg-white border border-gray-100 rounded-3xl p-6 hover:shadow-xl transition-shadow cursor-pointer group">
        <div class="w-full h-48 bg-gray-200 rounded-2xl mb-4 overflow-hidden">
           <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&q=80&w=600" alt="Audio" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
        </div>
        <span class="text-xs font-bold text-blue-500 mb-2 block">Reviews</span>
        <h2 class="text-lg font-bold text-black mb-2 group-hover:text-gray-600 transition">Top 5 Headphones for 2026</h2>
        <p class="text-sm text-gray-500">We tested the best audio gear on the market. Here is our final verdict.</p>
      </div>

      <!-- Card 3 -->
      <div class="bg-white border border-gray-100 rounded-3xl p-6 hover:shadow-xl transition-shadow cursor-pointer group">
        <div class="w-full h-48 bg-gray-200 rounded-2xl mb-4 overflow-hidden">
           <img src="https://images.unsplash.com/photo-1526406915894-7bcd65f60845?auto=format&fit=crop&q=80&w=600" alt="Workspace" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
        </div>
        <span class="text-xs font-bold text-amber-500 mb-2 block">Tips & Tricks</span>
        <h2 class="text-lg font-bold text-black mb-2 group-hover:text-gray-600 transition">Organize Your Workspace</h2>
        <p class="text-sm text-gray-500">Simple tips to keep your desk clean, minimal, and highly productive.</p>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-200 py-6 text-center text-xs text-gray-400">
    <p>Copyright © 2026 Stuffsus.</p>
  </footer>

</body>
</html>