<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Special Promotions - FAMSWORLD</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans">

  <!-- Header -->
  <header class="bg-slate-900 border-b border-slate-800 py-4 px-6 flex justify-between items-center sticky top-0 z-50">
    <a href="/" class="text-orange-500 hover:text-orange-400 font-bold text-xs flex items-center gap-1 transition">
      ← BACK TO HOME
    </a>
    <h1 class="text-sm font-black text-white tracking-widest uppercase">PROMOTIONS & DEALS</h1>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="mb-8 text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-2">🔥 Hot Deals & Promotions</h2>
      <p class="text-xs text-slate-400">Exclusive discount items available for a limited time only.</p>
    </div>

    <% if (locals.promoItems && promoItems.length > 0) { %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
        <% promoItems.forEach(item => { %>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col hover:border-slate-700 transition group relative">
            
            <!-- Discount Badge -->
            <% if (item.badge) { %>
              <span class="absolute top-2 left-2 bg-red-600 text-white text-[10px] font-black px-2 py-0.5 rounded shadow z-10">
                <%= item.badge %>
              </span>
            <% } %>

            <!-- Image -->
            <div class="w-full h-48 bg-slate-950 overflow-hidden relative">
              <img 
                src="<%= item.image || item.cover %>" 
                alt="<%= item.title %>" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              >
            </div>

            <!-- Info -->
            <div class="p-3.5 flex flex-col flex-grow justify-between gap-2">
              <div>
                <span class="text-[10px] text-slate-500 uppercase font-semibold tracking-wider">
                  <%= item.category %>
                </span>
                <h3 class="text-xs font-bold text-slate-200 line-clamp-2 mt-1">
                  <%= item.title %>
                </h3>
              </div>

              <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                  <span class="text-sm font-black text-emerald-400">$<%= item.price %></span>
                  <% if (item.oldPrice) { %>
                    <span class="text-[10px] text-slate-500 line-through ml-1">$<%= item.oldPrice %></span>
                  <% } %>
                </div>

                <form action="/cart/add/<%= item._id || item.id %>" method="POST">
                  <input type="hidden" name="title" value="<%= item.title %>">
                  <input type="hidden" name="price" value="<%= item.price %>">
                  <input type="hidden" name="image" value="<%= item.image %>">
                  <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-bold px-2.5 py-1.5 rounded-lg transition">
                    + Cart
                  </button>
                </form>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-12 text-slate-500 text-sm">
        No promotion items available at the moment.
      </div>
    <% } %>
  </main>

</body>
</html>