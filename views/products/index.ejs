<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FAMSWORLD - Home</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- TOP NAVBAR -->
  <%- include('../partials/navbar') %>

  <!-- MAIN CONTENT AREA -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-8">

    <!-- 1. WEBSITE HERO / ABOUT BANNER SECTION -->
    <section class="bg-gradient-to-r from-slate-900 via-slate-900 to-orange-950/40 border border-slate-800 rounded-3xl p-8 mb-12 shadow-2xl relative overflow-hidden">
      <div class="max-w-3xl relative z-10">
        <span class="bg-orange-500/10 text-orange-400 border border-orange-500/30 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest inline-block mb-3">
          Welcome to FAMSWORLD
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight mb-4">
          All-In-One Digital Manga Reader & Tech Store
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
          FAMSWORLD သည် သင်နှစ်သက်သော <span class="text-orange-400 font-bold">Comics & Manga</span> များကို အွန်လိုင်းမှ တိုက်ရိုက်ဖတ်ရှုနိုင်ပြီး၊ အရည်အသွေးမြင့် <span class="text-orange-400 font-bold">Electronics</span> နည်းပညာပစ္စည်းများကို သိုလှောင်ဝယ်ယူနိုင်သော E-Commerce Platform ဖြစ်ပါသည်။
        </p>

        <!-- Feature Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-800/80">
          <div class="flex items-center gap-2">
            <span class="text-base">📖</span>
            <span class="text-[11px] font-bold text-slate-300">Instant Reader</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-base">⚡</span>
            <span class="text-[11px] font-bold text-slate-300">Fast Tech Delivery</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-base">🧾</span>
            <span class="text-[11px] font-bold text-slate-300">Instant E-Slip</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. COMICS & MANGA SECTION (10 ITEMS) -->
    <section class="mb-14">
      <div class="flex justify-between items-end mb-6 pb-3 border-b border-slate-800">
        <div>
          <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
            <span>📚</span> POPULAR COMICS & MANGA
          </h2>
          <p class="text-xs text-slate-400 mt-1">Read top manga chapters online or buy digital copies.</p>
        </div>
        <a href="/products/category/comics-manga" class="text-xs font-bold text-orange-400 hover:text-orange-300 transition flex items-center gap-1">
          View All Manga →
        </a>
      </div>

      <!-- Manga Grid (10 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
        <% if (comics && comics.length > 0) { %>
          <% comics.slice(0, 10).forEach(item => { %>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-col justify-between hover:border-orange-500/50 hover:-translate-y-1 transition duration-300 shadow-xl">
              <div>
                <!-- Cover Image -->
                <div class="h-52 bg-slate-800 rounded-lg overflow-hidden flex items-center justify-center mb-3 relative">
                  <img src="<%= item.image %>" alt="<%= item.title %>" class="h-full w-full object-cover">
                  <span class="absolute top-2 left-2 bg-slate-950/80 text-orange-400 text-[9px] font-bold px-2 py-0.5 rounded border border-orange-500/30">
                    <%= item.badge || 'HOT' %>
                  </span>
                </div>

                <!-- Title & Price -->
                <h3 class="font-bold text-xs text-white line-clamp-1"><%= item.title %></h3>
                <p class="text-[10px] text-slate-400 mt-0.5">Author: Eiichiro Oda</p>
                <div class="mt-2 font-black text-orange-400 text-sm">$<%= item.price %></div>
              </div>

              <!-- Buttons: Read & Buy -->
              <div class="mt-4 grid grid-cols-2 gap-2">
                <a href="/manga/read/<%= item._id || item.id %>" class="text-center bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold py-1.5 rounded-lg text-[10px] transition uppercase flex items-center justify-center gap-1">
                  📖 Read
                </a>
                <a href="/eslip/<%= item._id || item.id %>" class="text-center bg-orange-500 hover:bg-orange-600 text-white font-black py-1.5 rounded-lg text-[10px] transition uppercase shadow-md flex items-center justify-center gap-1">
                  🛒 Buy
                </a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </section>

    <!-- 3. ELECTRONICS SECTION (10 ITEMS) -->
    <section class="mb-14">
      <div class="flex justify-between items-end mb-6 pb-3 border-b border-slate-800">
        <div>
          <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
            <span>🔌</span> TOP ELECTRONICS & TECH
          </h2>
          <p class="text-xs text-slate-400 mt-1">High quality gadgets and gaming equipment.</p>
        </div>
        <a href="/products/category/electronics" class="text-xs font-bold text-orange-400 hover:text-orange-300 transition flex items-center gap-1">
          View All Tech →
        </a>
      </div>

      <!-- Electronics Grid (10 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
        <% if (electronics && electronics.length > 0) { %>
          <% electronics.slice(0, 10).forEach(item => { %>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-col justify-between hover:border-orange-500/50 hover:-translate-y-1 transition duration-300 shadow-xl">
              <div>
                <!-- Image -->
                <div class="h-44 bg-slate-800 rounded-lg overflow-hidden flex items-center justify-center mb-3 relative">
                  <img src="<%= item.image %>" alt="<%= item.title %>" class="h-full w-full object-cover">
                  <% if (item.badge) { %>
                    <span class="absolute top-2 left-2 bg-red-500 text-white text-[9px] font-black px-2 py-0.5 rounded">
                      <%= item.badge %>
                    </span>
                  <% } %>
                </div>

                <!-- Title & Price -->
                <h3 class="font-bold text-xs text-white line-clamp-1"><%= item.title %></h3>
                <p class="text-[10px] text-slate-400 mt-0.5">Category: Gadgets</p>
                <div class="mt-2 font-black text-orange-400 text-sm">$<%= item.price %></div>
              </div>

              <!-- Add to Cart Action -->
              <form action="/cart/add/<%= item._id || item.id %>" method="POST" class="mt-4">
                <input type="hidden" name="title" value="<%= item.title %>">
                <input type="hidden" name="price" value="<%= item.price %>">
                <input type="hidden" name="image" value="<%= item.image %>">
                <button type="submit" class="w-full bg-slate-800 hover:bg-orange-500 border border-slate-700 hover:border-orange-500 text-white font-bold py-2 rounded-lg text-[10px] transition uppercase tracking-wider flex items-center justify-center gap-1">
                  🛒 Add to Cart
                </button>
              </form>
            </div>
          <% }); %>
        <% } %>
      </div>
    </section>

  </main>

  <!-- BOTTOM FOOTER -->
  <%- include('../partials/footer') %>

</body>
</html>