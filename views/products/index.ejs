<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pageTitle || 'FAMSWORLD - Store' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

  <% 
    const user = locals.currentUser || null;
    const wishlist = locals.wishlistItems || [];
    const cart = locals.cartItems || [];
    const catList = locals.categories || [];
    const productList = locals.products || [];
  %>

  <!-- Main Navbar -->
  <nav x-data="{ shopOpen: false, searchOpen: false, profileOpen: false, wishlistOpen: false, cartOpen: false }" class="bg-white shadow-sm sticky top-0 z-50">
    <div class="py-4 px-8 flex justify-between items-center border-b relative">
      <a href="/products" class="text-2xl font-black tracking-wider text-slate-900">
        <span class="text-orange-500">FAM</span>SWORLD
      </a>
      
      <div class="hidden md:flex gap-8 text-xs font-bold tracking-wide items-center">
        <a href="/products" class="hover:text-orange-500 <%= !locals.pageTitle || locals.pageTitle === 'All Products' ? 'text-orange-500' : '' %>">HOME</a>
        <a href="/products/category/electronics" class="hover:text-orange-500 <%= locals.pageTitle && locals.pageTitle.includes('ELECTRONICS') ? 'text-orange-500' : '' %>">ELECTRONICS</a>
        <a href="/products/best-sellers" class="hover:text-orange-500 <%= locals.pageTitle === 'Best Sellers' ? 'text-orange-500' : '' %>">BEST SELLERS</a>
        <a href="/products/new-arrivals" class="hover:text-orange-500 <%= locals.pageTitle === 'New Arrivals' ? 'text-orange-500' : '' %>">NEW ARRIVALS</a>
        <a href="/about" class="hover:text-orange-500">ABOUT US</a>
        <a href="/contact" class="hover:text-orange-500">CONTACT US</a>
      </div>

      <div class="flex items-center gap-6 text-slate-700 text-lg relative">
        <!-- Wishlist Drawer -->
        <div class="relative">
          <button @click="wishlistOpen = !wishlistOpen" class="hover:text-orange-500 relative flex items-center">
            ❤️
            <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[9px] rounded-full h-4 w-4 flex items-center justify-center font-bold">
              <%= wishlist.length %>
            </span>
          </button>
          <div x-show="wishlistOpen" @click.outside="wishlistOpen = false" x-cloak x-transition class="absolute right-0 mt-2 w-72 bg-white border shadow-xl rounded-md p-4 z-50">
            <h4 class="font-bold text-xs text-slate-900 border-b pb-2 mb-3">Saved Favorites</h4>
            <% if (wishlist.length > 0) { %>
              <div class="space-y-3 max-h-48 overflow-y-auto">
                <% wishlist.forEach(item => { %>
                  <div class="flex items-center justify-between border-b pb-2">
                    <div class="flex items-center gap-3">
                      <img src="<%= item.image %>" class="w-10 h-10 object-cover rounded">
                      <div>
                        <p class="text-xs font-bold text-slate-800 line-clamp-1"><%= item.title %></p>
                        <p class="text-xs text-orange-500 font-bold">$<%= item.price %></p>
                      </div>
                    </div>
                    <form action="/wishlist/remove/<%= item.id || item._id %>" method="POST">
                      <button type="submit" class="text-red-500 text-xs font-bold px-2 py-1">✕</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-gray-400 text-center py-4">No favorite items saved.</p>
            <% } %>
          </div>
        </div>

        <!-- Cart Drawer -->
        <div class="relative">
          <button @click="cartOpen = !cartOpen" class="hover:text-orange-500 relative flex items-center">
            🛒
            <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[9px] rounded-full h-4 w-4 flex items-center justify-center font-bold">
              <%= cart.length %>
            </span>
          </button>
          <div x-show="cartOpen" @click.outside="cartOpen = false" x-cloak x-transition class="absolute right-0 mt-2 w-80 bg-white border shadow-xl rounded-md p-4 z-50">
            <h4 class="font-bold text-xs text-slate-900 border-b pb-2 mb-3">Shopping Cart</h4>
            <% if (cart.length > 0) { %>
              <div class="space-y-3 max-h-48 overflow-y-auto">
                <% cart.forEach(item => { %>
                  <div class="flex items-center justify-between border-b pb-2">
                    <div class="flex items-center gap-3">
                      <img src="<%= item.image %>" class="w-10 h-10 object-cover rounded">
                      <div>
                        <p class="text-xs font-bold text-slate-800"><%= item.title %></p>
                        <p class="text-xs text-gray-500">Qty: <%= item.qty || 1 %> x $<%= item.price %></p>
                      </div>
                    </div>
                    <form action="/cart/remove/<%= item.id || item._id %>" method="POST">
                      <button type="submit" class="text-red-500 text-xs font-bold px-2 py-1">✕</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-gray-400 text-center py-4">Cart is empty.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto py-12 px-8">

    <!-- Category Section -->
    <% if (catList.length > 0) { %>
      <div class="mb-12">
        <h2 class="text-center font-bold text-lg mb-6 border-b-2 border-orange-500 w-max mx-auto pb-1">CATEGORIES</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          <% catList.forEach(cat => { %>
            <a href="/products/category/<%= cat.name.toLowerCase() %>" class="bg-white p-4 border rounded text-center hover:shadow-md cursor-pointer transition">
              <img src="<%= cat.image %>" class="w-16 h-16 rounded-full mx-auto object-cover mb-2">
              <span class="text-xs font-bold text-gray-700"><%= cat.name %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Product Grid Section -->
    <h2 class="font-bold text-lg mb-6 border-b-2 border-orange-500 w-max pb-1 uppercase">
      <%= locals.pageTitle || 'PRODUCTS' %>
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <% if (productList.length > 0) { %>
        <% productList.forEach(product => { %>
          <div class="bg-white border rounded p-4 flex flex-col justify-between hover:shadow-md relative transition">
            
            <div class="flex justify-between items-start">
              <% if (product.badge) { %>
                <span class="bg-orange-500 text-white text-[9px] font-bold px-2 py-0.5 rounded-sm"><%= product.badge %></span>
              <% } else { %> <div></div> <% } %>

              <form action="/wishlist/add/<%= product._id || product.id %>" method="POST">
                <input type="hidden" name="title" value="<%= product.title || product.name %>">
                <input type="hidden" name="price" value="<%= product.price %>">
                <input type="hidden" name="image" value="<%= product.image %>">
                <button type="submit" class="text-gray-400 hover:text-red-500">❤️</button>
              </form>
            </div>

            <div class="h-44 flex items-center justify-center my-2">
              <img src="<%= product.image %>" alt="<%= product.title || product.name %>" class="max-h-full object-contain">
            </div>

            <div>
              <h3 class="font-bold text-xs text-slate-800 line-clamp-1"><%= product.title || product.name %></h3>
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-orange-500 font-bold text-sm">$<%= product.price %></span>
                <% if (product.oldPrice) { %>
                  <span class="text-gray-400 line-through text-xs">$<%= product.oldPrice %></span>
                <% } %>
              </div>
            </div>

            <form action="/cart/add/<%= product._id || product.id %>" method="POST" class="mt-4">
              <input type="hidden" name="title" value="<%= product.title || product.name %>">
              <input type="hidden" name="price" value="<%= product.price %>">
              <input type="hidden" name="image" value="<%= product.image %>">
              <button type="submit" class="w-full bg-orange-500 text-white font-bold py-2 rounded-sm text-xs hover:bg-orange-600 transition">
                🛒 ADD TO CART
              </button>
            </form>
          </div>
        <% }) %>
      <% } else { %>
        <p class="col-span-full text-center text-xs text-gray-400 py-8">No products available in this section.</p>
      <% } %>
    </div>
  </main>

  <!-- SweetAlert Script -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const msg = urlParams.get('msg');

    if (msg) {
      let textMsg = "လုပ်ဆောင်ချက် အောင်မြင်ပါသည်!";

      if (msg === 'cart_added') textMsg = "Cart ထဲသို့ အောင်မြင်စွာ ထည့်ပြီးပါပြီ။";
      if (msg === 'cart_removed') textMsg = "Cart ထဲမှ အောင်မြင်စွာ ဖျက်လိုက်ပါပြီ။";
      if (msg === 'wishlist_added') textMsg = "Favorites ထဲသို့ အောင်မြင်စွာ သိမ်းဆည်းလိုက်ပါပြီ။";
      if (msg === 'wishlist_removed') textMsg = "Favorites ထဲမှ အောင်မြင်စွာ ဖျက်လိုက်ပါပြီ။";

      Swal.fire({
        title: 'အောင်မြင်ပါသည်!',
        text: textMsg,
        icon: 'success',
        timer: 2000,
        showConfirmButton: false
      });

      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>
</body>
</html>