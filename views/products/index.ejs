<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stuffsus - Tech</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-[#fcfcfc] text-black flex flex-col min-h-screen">

  <%- include('../partials/navbar', { activePage: 'shop' }) %>
  
  <!-- Hero Section -->
  <div class="w-full max-w-[1400px] mx-auto px-6 mt-6">
    <div class="relative w-full h-[240px] md:h-[320px] rounded-3xl overflow-hidden bg-gray-900 flex items-center justify-center group cursor-pointer shadow-lg">
      <img src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&q=80&w=2000" alt="Tech" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-40 transition-all duration-700 ease-out group-hover:scale-105">
      <div class="relative z-10 flex flex-col items-center text-center px-4">
        <h1 class="text-4xl md:text-7xl font-black text-white leading-tight tracking-tight drop-shadow-md mb-4">
          Explore Tech Products
        </h1>
        <p class="text-gray-200 text-xs md:text-sm font-medium max-w-md">
         Discover the latest technology, gadgets, and accessories built for your everyday workflow.
        </p>
      </div>
    </div>
  </div>

  <!-- Search & Filter Header -->
  <div class="max-w-[1400px] mx-auto px-6 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
    <form action="/products" method="GET" class="relative w-full max-w-md">
      <input type="text" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Search tech items..." class="w-full bg-white border border-gray-200 rounded-full py-3 pl-5 pr-24 text-sm font-medium focus:outline-none focus:border-black shadow-sm transition">
      <button type="submit" class="absolute right-1.5 top-1.5 bottom-1.5 bg-black text-white text-xs font-bold px-5 rounded-full hover:bg-gray-800 transition">Search</button>
    </form>
  </div>

  <main class="max-w-[1400px] mx-auto px-6 pb-20 flex flex-col lg:flex-row gap-10 flex-grow w-full">
    
    <!-- LEFT SIDEBAR (Category) -->
    <aside class="w-full lg:w-[240px] shrink-0 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm h-fit">
      <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Categories</h3>
      <ul class="space-y-3 text-sm font-semibold text-gray-600">
        <li>
          <a href="/products?category=All Product" class="flex items-center justify-between p-2 rounded-xl transition <%= currentCategory === 'All Product' ? 'bg-black text-white font-bold shadow' : 'hover:bg-gray-50 hover:text-black' %>">
            <span>All Product</span>
          </a>
        </li>
        <li>
          <a href="/products?category=For Home" class="flex items-center p-2 rounded-xl transition <%= currentCategory === 'For Home' ? 'bg-black text-white font-bold shadow' : 'hover:bg-gray-50 hover:text-black' %>">
            For Home
          </a>
        </li>
        <li>
          <a href="/products?category=For Music" class="flex items-center p-2 rounded-xl transition <%= currentCategory === 'For Music' ? 'bg-black text-white font-bold shadow' : 'hover:bg-gray-50 hover:text-black' %>">
            For Music
          </a>
        </li>
        <li>
          <a href="/products?category=For Phone" class="flex items-center p-2 rounded-xl transition <%= currentCategory === 'For Phone' ? 'bg-black text-white font-bold shadow' : 'hover:bg-gray-50 hover:text-black' %>">
            For Phone
          </a>
        </li>
        <li>
          <a href="/products?category=For Storage" class="flex items-center p-2 rounded-xl transition <%= currentCategory === 'For Storage' ? 'bg-black text-white font-bold shadow' : 'hover:bg-gray-50 hover:text-black' %>">
            For Storage
          </a>
        </li>
      </ul>
    </aside>

    <!-- RIGHT PRODUCT GRID -->
    <section class="flex-grow">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition duration-300 flex flex-col justify-between">
              <div>
                <div class="bg-gray-50 rounded-2xl p-4 mb-4 relative h-[200px] flex items-center justify-center overflow-hidden">
                  <span class="absolute top-3 right-3 bg-white text-gray-600 text-[10px] font-bold px-3 py-1 rounded-full shadow-sm border border-gray-100"><%= product.category || 'Tech' %></span>
                  <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-32 h-32 object-contain product-img hover:scale-105 transition duration-300">
                </div>
                <h3 class="font-bold text-sm text-black mb-1 truncate product-name"><%= product.name %></h3>
                <p class="text-xs text-gray-400 mb-3 truncate font-medium"><%= product.brand %> • High Quality</p>
              </div>

              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-1 text-[11px]">
                    <span class="text-amber-500">★</span> <span class="font-bold text-black">5.0</span> <span class="text-gray-400">(1.2k)</span>
                  </div>
                  <span class="font-black text-base text-black product-price" data-price="<%= product.price %>">$<%= product.price %></span>
                </div>
                
                <div class="flex gap-2">
                  <button type="button" onclick="addToCart('<%= product.id %>', this)" class="w-1/2 border border-gray-200 text-black text-xs font-bold py-2.5 rounded-xl hover:bg-gray-50 transition active:scale-95">Add to Cart</button>
                  <button type="button" onclick="buyNow('<%= product.id %>', this)" class="w-1/2 bg-black text-white text-xs font-bold py-2.5 rounded-xl hover:bg-gray-800 transition active:scale-95 shadow-sm">Buy Now</button>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center py-20 bg-white rounded-3xl border border-gray-100">
            <p class="text-gray-500 font-medium">No products found.</p>
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="flex items-center justify-center gap-2 mt-12 text-sm font-semibold text-gray-600 flex-wrap">
          <% if (currentPage > 1) { %>
            <% 
              let prevUrl = `/products?page=${currentPage - 1}`;
              if (searchQuery) prevUrl += `&search=${encodeURIComponent(searchQuery)}`;
              if (currentCategory) prevUrl += `&category=${encodeURIComponent(currentCategory)}`;
            %>
            <a href="<%= prevUrl %>" class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 transition">❮ Previous</a>
          <% } %>
          
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% 
              let pageUrl = `/products?page=${i}`;
              if (searchQuery) pageUrl += `&search=${encodeURIComponent(searchQuery)}`;
              if (currentCategory) pageUrl += `&category=${encodeURIComponent(currentCategory)}`;
              let activeClass = (currentPage === i) ? 'bg-black text-white font-bold shadow' : 'border border-gray-200 hover:bg-gray-50';
            %>
            <a href="<%= pageUrl %>" class="w-10 h-10 rounded-xl flex items-center justify-center transition <%= activeClass %>"><%= i %></a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <% 
              let nextUrl = `/products?page=${currentPage + 1}`;
              if (searchQuery) nextUrl += `&search=${encodeURIComponent(searchQuery)}`;
              if (currentCategory) nextUrl += `&category=${encodeURIComponent(currentCategory)}`;
            %>
            <a href="<%= nextUrl %>" class="px-4 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 transition">Next ❯</a>
          <% } %>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-[1400px] mx-auto px-6 py-10 border-t border-gray-200 text-sm font-semibold text-gray-500 mt-auto">
    <div class="flex flex-col md:flex-row justify-between mb-10 gap-8">
      <div class="flex gap-16">
        <div class="flex flex-col gap-3">
          <span class="text-black font-bold mb-1">About</span>
          <a href="/blog" class="hover:text-black transition">Blog</a>
          <a href="#" class="hover:text-black transition">Meet The Team</a>
          <a href="#" class="hover:text-black transition">Contact Us</a>
        </div>
        <div class="flex flex-col gap-3">
          <span class="text-black font-bold mb-1">Support</span>
          <a href="#" class="hover:text-black transition">Help Center</a>
          <a href="#" class="hover:text-black transition">Shipping</a>
          <a href="#" class="hover:text-black transition">Return</a>
          <a href="#" class="hover:text-black transition">FAQ</a>
        </div>
      </div>
      <div class="flex items-start md:items-end gap-3 text-black">
        <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center hover:bg-black hover:text-white transition cursor-pointer">𝕏</span>
        <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center hover:bg-black hover:text-white transition cursor-pointer">f</span>
        <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center hover:bg-black hover:text-white transition cursor-pointer">in</span>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center text-xs text-gray-400 border-t border-gray-100 pt-6 gap-4">
      <p>Copyright © 2026 Stuffsus. All Rights Reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-gray-600 transition">Terms of Service</a>
        <a href="#" class="hover:text-gray-600 transition">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <!-- JS for Add to Cart & Buy Now -->
 <script>
  document.addEventListener('DOMContentLoaded', () => {
    // Navbar cart badge update function
    function updateNavCartBadge() {
      const cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      const totalQty = cart.reduce((sum, item) => sum + (item.qty || 1), 0);
      const badge = document.getElementById('nav-cart-count');

      if (badge) {
        if (totalQty > 0) {
          badge.innerText = totalQty;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    }

    // Initial badge check on load
    updateNavCartBadge();

    // Intercept Add to Cart forms or buttons without changing UI
    document.querySelectorAll('form[action="/add-to-cart"], button').forEach(el => {
      const form = el.tagName === 'FORM' ? el : el.closest('form');
      
      if (form && (form.getAttribute('action') === '/add-to-cart' || form.querySelector('button[type="submit"]'))) {
        form.addEventListener('submit', function(e) {
          e.preventDefault(); // Page ကို refresh မဖြစ်စေဘဲ နောက်ကွယ်မှ သိမ်းမည်

          const card = this.closest('.bg-white') || this.closest('div');
          if (!card) return;

          const titleEl = card.querySelector('h3') || card.querySelector('h4');
          const priceEl = card.querySelector('.font-black') || card.querySelector('span');
          const imgEl = card.querySelector('img');
          const idInput = form.querySelector('input[name="productId"]');

          const title = titleEl ? titleEl.innerText.trim() : "Tech Product";
          let price = 29.90;
          if (priceEl) {
            const priceVal = priceEl.innerText.replace('$', '').trim();
            if (!isNaN(priceVal)) price = parseFloat(priceVal);
          }
          const img = imgEl ? imgEl.getAttribute('src') : "https://placehold.co/400";
          const productId = idInput ? idInput.value : Date.now().toString();

          let cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
          let existingItem = cart.find(item => item.id === productId);

          if (existingItem) {
            existingItem.qty += 1;
          } else {
            cart.push({
              id: productId,
              title: title,
              variant: "Standard Edition",
              price: price,
              qty: 1,
              img: img
            });
          }

          localStorage.setItem('selected_checkout_item', JSON.stringify(cart));
          updateNavCartBadge();

          // Visual feedback on button without changing UI design
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            const originalText = submitBtn.innerText;
            submitBtn.innerText = "Added! ✓";
            submitBtn.style.backgroundColor = "#10b981";
            submitBtn.style.color = "#fff";
            setTimeout(() => {
              submitBtn.innerText = originalText;
              submitBtn.style.backgroundColor = "";
              submitBtn.style.color = "";
            }, 1000);
          }
        });
      }
    });
  });
</script>

</body>
</html>