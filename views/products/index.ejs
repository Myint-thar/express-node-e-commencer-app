<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop All Categories - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- Navbar Component -->
 <%- include('../partials/navbar') %>

  <!-- Shop All Banner -->
  <div class="bg-slate-950 text-white py-10 px-8 border-b border-orange-500/30">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-3xl font-black tracking-wider text-orange-500">EXPLORE ALL CATEGORIES</h1>
        <p class="text-xs text-slate-400 mt-1">Discover top Electronics devices and Manga & Comics collections.</p>
      </div>
    </div>
  </div>

  <main class="max-w-7xl mx-auto py-10 px-6 space-y-16">

    <!-- ================= SECTION 1: ELECTRONICS (10 Cards) ================= -->
    <section>
      <!-- Section Title & View All Link -->
      <div class="flex justify-between items-end pb-4 mb-6 border-b border-slate-200">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">⚡</span>
            <h2 class="text-xl font-black text-slate-900 tracking-wide">ELECTRONICS & TECH</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Top 10 Featured Smart Gadgets & Audio Gear</p>
        </div>
        <a href="/products/category/electronics" class="text-xs font-bold text-orange-500 hover:text-orange-600 flex items-center gap-1 transition">
          VIEW ALL ELECTRONICS (120+) ➡
        </a>
      </div>

      <!-- Electronics Grid (10 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5">
        <% (locals.electronics || []).slice(0, 10).forEach(function(product) { %>
          <div class="bg-white border border-slate-200 rounded-xl p-3 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition duration-300 relative group">
            
            <div class="flex justify-between items-start">
              <% if(product.badge) { %>
                <span class="bg-slate-900 text-orange-400 border border-orange-500/30 text-[8px] font-black px-1.5 py-0.5 rounded uppercase"><%= product.badge %></span>
              <% } else { %> <span></span> <% } %>

              <form action="/wishlist/add/<%= product._id %>" method="POST">
                <input type="hidden" name="title" value="<%= product.title %>">
                <input type="hidden" name="price" value="<%= product.price %>">
                <input type="hidden" name="image" value="<%= product.image %>">
                <button type="submit" class="text-slate-300 hover:text-red-500 transition text-sm">❤️</button>
              </form>
            </div>

            <div class="h-36 flex items-center justify-center my-2 bg-slate-50 rounded-lg p-2 overflow-hidden">
              <img src="<%= product.image %>" alt="<%= product.title %>" class="max-h-full object-contain group-hover:scale-105 transition duration-300">
            </div>

            <div>
              <span class="text-[8px] text-slate-400 font-bold uppercase"><%= product.category %></span>
              <h3 class="font-bold text-xs text-slate-900 line-clamp-1"><%= product.title %></h3>
              <div class="text-orange-500 font-black text-xs mt-1">$<%= product.price %></div>
            </div>

            <form action="/cart/add/<%= product._id %>" method="POST" class="mt-3">
              <input type="hidden" name="title" value="<%= product.title %>">
              <input type="hidden" name="price" value="<%= product.price %>">
              <input type="hidden" name="image" value="<%= product.image %>">
              <button type="submit" class="w-full bg-slate-900 text-white font-bold py-1.5 rounded-lg text-[10px] hover:bg-orange-500 transition">
                ⚡ ADD TO CART
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    </section>


    <!-- ================= SECTION 2: COMICS & MANGA (10 Cards) ================= -->
    <section>
      <!-- Section Title & View All Link -->
      <div class="flex justify-between items-end pb-4 mb-6 border-b border-slate-200">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">📚</span>
            <h2 class="text-xl font-black text-slate-900 tracking-wide">COMICS & MANGA</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Top 10 Manga Volumes & Graphic Novels</p>
        </div>
        <a href="/products/category/comics-manga" class="text-xs font-bold text-orange-500 hover:text-orange-600 flex items-center gap-1 transition">
          VIEW ALL MANGA (120+) ➡
        </a>
      </div>

      <!-- Comics Grid (10 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5">
        <% (locals.comics || []).slice(0, 10).forEach(function(product) { %>
          <div class="bg-white border border-slate-200 rounded-xl p-3 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition duration-300 relative group">
            
            <div class="flex justify-between items-start">
              <% if(product.badge) { %>
                <span class="bg-orange-500 text-white text-[8px] font-black px-1.5 py-0.5 rounded uppercase"><%= product.badge %></span>
              <% } else { %> <span></span> <% } %>

              <form action="/wishlist/add/<%= product._id %>" method="POST">
                <input type="hidden" name="title" value="<%= product.title %>">
                <input type="hidden" name="price" value="<%= product.price %>">
                <input type="hidden" name="image" value="<%= product.image %>">
                <button type="submit" class="text-slate-300 hover:text-red-500 transition text-sm">❤️</button>
              </form>
            </div>

            <div class="h-36 flex items-center justify-center my-2 bg-slate-50 rounded-lg p-2 overflow-hidden">
              <img src="<%= product.image %>" alt="<%= product.title %>" class="max-h-full object-cover group-hover:scale-105 transition duration-300">
            </div>

            <div>
              <span class="text-[8px] text-orange-600 font-bold uppercase"><%= product.category %></span>
              <h3 class="font-bold text-xs text-slate-900 line-clamp-1"><%= product.title %></h3>
              <div class="text-orange-500 font-black text-xs mt-1">$<%= product.price %></div>
            </div>

            <a href="/products/category/comics-manga" class="mt-3 block text-center bg-slate-900 text-white font-bold py-1.5 rounded-lg text-[10px] hover:bg-orange-500 transition">
              📖 READ & BUY
            </a>
          </div>
        <% }); %>
      </div>
    </section>

  </main>

  <!-- SweetAlert2 English Popup Script -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const msg = urlParams.get('msg');
    if (msg) {
      let titleText = "Success!";
      let bodyText = "Action completed successfully!";
      if (msg === 'cart_added') { titleText = "Added to Cart!"; bodyText = "Item has been added to cart."; }
      if (msg === 'wishlist_added') { titleText = "Added to Wishlist!"; bodyText = "Item saved to favorites."; }
      
      Swal.fire({
        title: titleText, text: bodyText, icon: 'success', timer: 2000, showConfirmButton: false
      });
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>

</body>
</html>