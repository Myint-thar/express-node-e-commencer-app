<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stuffsus - <%= brandName %> Products</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-[#fcfcfc] text-black flex flex-col min-h-screen">

  <%- include('../partials/navbar', { activePage: 'brands' }) %>

  <!-- Header Section with proper spacing -->
  <div class="w-full max-w-[1400px] mx-auto px-6 mt-6">
    <div class="bg-black text-white rounded-3xl p-8 md:p-12 flex flex-col md:flex-row justify-between items-center gap-6 shadow-lg">
      <div>
        <span class="text-xs uppercase tracking-widest text-gray-400 font-bold mb-2 block">Brand Collection</span>
        <h1 class="text-3xl md:text-5xl font-black"><%= brandName %> Products</h1>
        <p class="text-gray-400 text-sm mt-2">Explore high-performance products and accessories from <%= brandName %>.</p>
      </div>
      <a href="/brands" class="px-6 py-3 bg-white text-black text-xs font-bold rounded-xl hover:bg-gray-100 transition shadow whitespace-nowrap">Back to Brands</a>
    </div>
  </div>

  <!-- Main Product Grid Section -->
  <main class="max-w-[1400px] mx-auto px-6 py-10 flex-grow w-full">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition duration-300 flex flex-col justify-between">
            <div>
              <div class="bg-gray-50 rounded-2xl p-4 mb-4 relative h-[200px] flex items-center justify-center overflow-hidden">
                <span class="absolute top-3 right-3 bg-white text-gray-600 text-[10px] font-bold px-3 py-1 rounded-full shadow-sm border border-gray-100"><%= product.category || brandName %></span>
                <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-32 h-32 object-contain product-img hover:scale-105 transition duration-300">
              </div>
              <h3 class="font-bold text-sm text-black mb-1 truncate product-name"><%= product.name %></h3>
              <p class="text-xs text-gray-400 mb-3 truncate font-medium"><%= product.brand %> • High Quality</p>
            </div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-1 text-[11px]">
                  <span class="text-amber-500">★</span> <span class="font-bold text-black">5.0</span> <span class="text-gray-400">(1.2k)</span>
                </div>
                <span class="font-black text-base text-black product-price" data-price="<%= product.price %>">$<%= product.price %></span>
              </div>
              
              <div class="flex gap-2">
                <button type="button" onclick="addToCart('<%= product.id %>', this)" class="w-1/2 border border-gray-200 text-black text-xs font-bold py-2.5 rounded-xl hover:bg-gray-50 transition active:scale-95">Add to Cart</button>
                <button type="button" onclick="buyNow('<%= product.id %>', this)" class="w-1/2 bg-black text-white text-xs font-bold py-2.5 rounded-xl hover:bg-gray-800 transition active:scale-95 shadow-sm">Buy Now</button>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full text-center py-20 bg-white rounded-3xl border border-gray-100">
          <p class="text-gray-500 font-medium">No products found for <%= brandName %>.</p>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="w-full max-w-[1400px] mx-auto px-6 py-10 border-t border-gray-200 text-sm font-semibold text-gray-500 mt-auto text-center">
    <p>Copyright © 2026 Stuffsus. All Rights Reserved.</p>
  </footer>

  <script>
    function updateNavCartBadge() {
      const cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      const totalQty = cart.reduce((sum, item) => sum + (item.qty || 1), 0);
      const badge = document.getElementById('nav-cart-count');

      if (badge) {
        if (totalQty > 0) {
          badge.innerText = totalQty;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    }

    document.addEventListener('DOMContentLoaded', updateNavCartBadge);

    function addToCart(productId, btnElement) {
      const card = btnElement.closest('.bg-white');
      const title = card.querySelector('.product-name').innerText;
      const price = parseFloat(card.querySelector('.product-price').getAttribute('data-price'));
      const img = card.querySelector('.product-img').getAttribute('src');

      let cart = JSON.parse(localStorage.getItem('selected_checkout_item')) || [];
      let existingItem = cart.find(item => item.id === productId);

      if (existingItem) {
        existingItem.qty += 1;
      } else {
        cart.push({
          id: productId,
          title: title,
          variant: "Standard Edition",
          price: price,
          qty: 1,
          img: img
        });
      }

      localStorage.setItem('selected_checkout_item', JSON.stringify(cart));
      updateNavCartBadge();

      const originalText = btnElement.innerText;
      btnElement.innerText = "Added! ✓";
      btnElement.classList.add('bg-emerald-500', 'text-white', 'border-emerald-500');
      
      setTimeout(() => {
        btnElement.innerText = originalText;
        btnElement.classList.remove('bg-emerald-500', 'text-white', 'border-emerald-500');
      }, 1200);
    }

    function buyNow(productId, btnElement) {
      const card = btnElement.closest('.bg-white');
      const title = card.querySelector('.product-name').innerText;
      const price = parseFloat(card.querySelector('.product-price').getAttribute('data-price'));
      const img = card.querySelector('.product-img').getAttribute('src');

      const buyItem = [{
        id: productId,
        title: title,
        variant: "Standard Edition",
        price: price,
        qty: 1,
        img: img
      }];

      localStorage.setItem('selected_checkout_item', JSON.stringify(buyItem));
      window.location.href = '/checkout';
    }
  </script>
</body>
</html>