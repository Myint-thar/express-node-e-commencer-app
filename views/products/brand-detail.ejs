    <!-- Main Content Container -->
    <main class="max-w-[1200px] w-full mx-auto px-6 py-8 flex-grow">
        <!-- Back Link -->
        <a href="/brands" class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-black mb-6 transition">
            ← Back to Brands
        </a>

        <!-- Title & Series Filters -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
            <div>
                <h1 class="text-3xl md:text-4xl font-black text-black tracking-tight">
                    <%= currentBrand.name %> Collection
                </h1>
                <p class="mt-1 text-gray-500 text-xs font-medium">
                    Explore genuine <%= currentBrand.name %> devices and official accessories.
                </p>
            </div>

            <!-- Series Filter Buttons -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2">
                <% currentBrand.seriesList.forEach((series, index) => { %>
                    <button onclick="filterSeries('<%= series %>', this)" 
                            class="series-btn px-4 py-2 text-xs font-bold rounded-full transition whitespace-nowrap <%= index === 0 ? 'bg-black text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                        <%= series %>
                    </button>
                <% }); %>
            </div>
        </div>

        <!-- Products Grid (3 Columns) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% currentBrand.products.forEach(product => { %>
                <div class="product-card bg-white border border-gray-100 rounded-2xl p-4 flex flex-col justify-between shadow-xs" data-series="<%= product.series %>">
                    
                    <!-- Image Container -->
                    <div class="relative bg-gray-50 rounded-xl h-48 w-full flex items-center justify-center p-4 mb-4 overflow-hidden">
                        <span class="absolute top-3 right-3 text-[10px] font-bold bg-white text-black px-2.5 py-1 rounded-full border border-gray-100 shadow-xs z-10">
                            <%= product.tag %>
                        </span>
                        <img src="<%= product.img %>" alt="<%= product.title %>" class="h-36 object-contain">
                    </div>

                    <!-- Product Info -->
                    <div class="mb-4">
                        <div class="text-[11px] text-gray-400 font-semibold mb-1"><%= product.series %></div>
                        <h3 class="text-sm font-bold text-gray-900 line-clamp-1 mb-1"><%= product.title %></h3>
                        <div class="text-base font-extrabold text-black">$<%= product.price %>.00</div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" onclick="addToCart('<%= product.id %>', '<%= product.title %>', '<%= product.series %>', <%= product.price %>, '<%= product.img %>')" class="w-full py-2 px-3 text-xs font-bold border border-gray-200 rounded-xl hover:bg-gray-50 active:scale-95 transition text-center">
                            Add to Cart
                        </button>
                        <button type="button" onclick="buyNow('<%= product.id %>', '<%= product.title %>', '<%= product.series %>', <%= product.price %>, '<%= product.img %>')" class="w-full py-2 px-3 text-xs font-bold bg-black text-white rounded-xl hover:bg-gray-800 active:scale-95 transition text-center">
                            Buy Now
                        </button>
                    </div>

                </div>
            <% }); %>
        </div>
    </main>

    <!-- Cart Modal -->
    <div id="cart-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-end">
        <div class="bg-white w-full max-w-md h-full p-6 flex flex-col justify-between shadow-2xl">
            <div>
                <div class="flex items-center justify-between border-b pb-4 mb-4">
                    <h2 class="text-lg font-black">Your Cart</h2>
                    <button onclick="toggleCartModal()" class="text-gray-400 hover:text-black text-lg font-bold">✕</button>
                </div>
                <div id="cart-items-container" class="space-y-3 max-h-[60vh] overflow-y-auto">
                    <p class="text-gray-400 text-xs text-center py-10">Your cart is empty.</p>
                </div>
            </div>
            <div class="border-t pt-4">
                <div class="flex justify-between items-center text-base font-black mb-4">
                    <span>Total:</span>
                    <span id="cart-total-price">$0.00</span>
                </div>
                <button onclick="checkoutCart()" class="w-full py-3 bg-black text-white text-xs font-bold rounded-xl hover:bg-gray-800 transition">
                    Proceed to Pay
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-gray-100 py-6 text-center text-xs text-gray-400 mt-auto">
        <p>© 2026 Stuffsus. All rights reserved.</p>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        let cart = [];

        // Buy Now ကိုနှိပ်ပါက Checkout စာမျက်နှာသို့ တိုက်ရိုက် သွားရောက်စေခြင်း
        function buyNow(id, title, series, price, img) {
            const selectedProduct = [{
                id: String(id),
                title: title,
                variant: series,
                price: Number(price),
                qty: 1,
                img: img
            }];
            localStorage.setItem('selected_checkout_item', JSON.stringify(selectedProduct));
            window.location.href = '/checkout';
        }

        function filterSeries(seriesName, btnElement) {
            document.querySelectorAll('.series-btn').forEach(btn => {
                btn.classList.remove('bg-black', 'text-white');
                btn.classList.add('bg-gray-100', 'text-gray-600');
            });
            btnElement.classList.remove('bg-gray-100', 'text-gray-600');
            btnElement.classList.add('bg-black', 'text-white');

            document.querySelectorAll('.product-card').forEach(card => {
                if (seriesName === 'All' || card.dataset.series === seriesName) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function addToCart(id, title, series, price, img) {
            cart.push({ id, title, series, price, img });
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const totalPriceEl = document.getElementById('cart-total-price');

            if (cart.length > 0) {
                badge.innerText = cart.length;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            if (cart.length === 0) {
                container.innerHTML = `<p class="text-gray-400 text-xs text-center py-10">Your cart is empty.</p>`;
                totalPriceEl.innerText = `$0.00`;
                return;
            }

            let total = 0;
            container.innerHTML = '';
            cart.forEach((item, index) => {
                total += item.price;
                container.innerHTML += `
                    <div class="flex items-center justify-between bg-gray-50 p-3 rounded-xl border border-gray-100 text-xs">
                        <div>
                            <h4 class="font-bold text-gray-900">${item.title}</h4>
                            <span class="font-extrabold text-black">$${item.price}.00</span>
                        </div>
                        <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 font-bold">Remove</button>
                    </div>
                `;
            });

            totalPriceEl.innerText = `$${total}.00`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        // Cart Modal ထဲမှ Proceed to Pay နှိပ်ပါက Checkout သို့ သွားခြင်း
        function checkoutCart() {
            if (cart.length === 0) return alert("Your cart is empty!");
            const checkoutItems = cart.map((item) => ({
                id: item.id,
                title: item.title,
                variant: item.series,
                price: item.price,
                qty: 1,
                img: item.img
            }));
            localStorage.setItem('selected_checkout_item', JSON.stringify(checkoutItems));
            window.location.href = '/checkout';
        }
    </script>
</body>
</html>