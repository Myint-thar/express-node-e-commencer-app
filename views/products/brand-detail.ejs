<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stuffsus - <%= (typeof brandSlug !=='undefined' ? brandSlug : 'Brand' ).toUpperCase() %>
    </title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-[#fcfcfc] text-black min-h-screen flex flex-col relative">

    <!-- Header / Navigation Bar -->
    <header
        class="bg-white/80 backdrop-blur-md border-b border-gray-100 sticky top-0 z-30 px-6 py-4 flex items-center justify-between max-w-[1400px] w-full mx-auto">
        <a href="/" class="text-2xl font-black tracking-tighter">Stuffsus</a>

        <div class="flex items-center gap-6">
            <a href="/brands" class="text-xs font-bold hover:text-gray-600 transition">Brands</a>
            <a href="/blog" class="text-xs font-bold hover:text-gray-600 transition">Blog</a>

            <button onclick="toggleCartModal()"
                class="relative p-2 bg-gray-100 hover:bg-gray-200 rounded-full transition">
                <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span id="cart-badge"
                    class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-extrabold w-5 h-5 rounded-full flex items-center justify-center animate-bounce">
                    0
                </span>
            </button>
        </div>
    </header>

    <% const currentSlug=(typeof brandSlug !=='undefined' ? brandSlug : 'apple' ).toLowerCase(); const brandDataMap={
        apple: { name: "Apple" , seriesList: ["All", "iPhone" , "MacBook" , "iPad" , "Apple Watch" ], products: [ { id:
        101, title: "iPhone 15 Pro Max" , series: "iPhone" , price: 1199, tag: "Flagship" ,
        img: "https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=500&q=80" }, { id: 102,
        title: "iPhone 15 Plus" , series: "iPhone" , price: 899, tag: "Popular" ,
        img: "https://images.unsplash.com/photo-1510557880182-3d4d3cba35a5?w=500&q=80" }, { id: 103,
        title: "MacBook Pro 16 M3 Max" , series: "MacBook" , price: 2499, tag: "Pro Performance" ,
        img: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=500&q=80" }, { id: 104,
        title: "MacBook Air 15 M2" , series: "MacBook" , price: 1299, tag: "Ultra Slim" ,
        img: "https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?w=500&q=80" }, { id: 105,
        title: "iPad Pro 13 M4 OLED" , series: "iPad" , price: 1299, tag: "New" ,
        img: "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=500&q=80" }, { id: 106,
        title: "Apple Watch Ultra 2" , series: "Apple Watch" , price: 799, tag: "Titanium" ,
        img: "https://images.unsplash.com/photo-1510017803434-a899398421b3?w=500&q=80" } ] }, samsung: { name: "Samsung"
        , seriesList: ["All", "Galaxy S Series" , "Galaxy Z Series" , "Galaxy A Series" , "Galaxy Tab" ], products: [ {
        id: 201, title: "Galaxy S24 Ultra" , series: "Galaxy S Series" , price: 1299, tag: "AI Phone" ,
        img: "https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=500&q=80" }, { id: 202,
        title: "Galaxy S24+" , series: "Galaxy S Series" , price: 999, tag: "Flagship" ,
        img: "https://images.unsplash.com/photo-1580910051074-3eb694886505?w=500&q=80" }, { id: 203,
        title: "Galaxy Z Fold 5" , series: "Galaxy Z Series" , price: 1799, tag: "Foldable" ,
        img: "https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?w=500&q=80" }, { id: 204,
        title: "Galaxy Z Flip 5" , series: "Galaxy Z Series" , price: 999, tag: "Compact Fold" ,
        img: "https://images.unsplash.com/photo-1541807084-5c52b6b3adef?w=500&q=80" }, { id: 205, title: "Galaxy A55 5G"
        , series: "Galaxy A Series" , price: 449, tag: "Best Value" ,
        img: "https://images.unsplash.com/photo-1565849904461-04a58ad377e0?w=500&q=80" }, { id: 206,
        title: "Galaxy Tab S9 Ultra" , series: "Galaxy Tab" , price: 1199, tag: "AMOLED Screen" ,
        img: "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=500&q=80" } ] } }; const
        currentBrand=brandDataMap[currentSlug] || { name: currentSlug.charAt(0).toUpperCase() + currentSlug.slice(1),
        seriesList: ["All", "Devices" , "Accessories" ], products: [ { id: 901, title: `${currentSlug.toUpperCase()}
        Official Device`, series: "Devices" , price: 799, tag: "Popular" ,
        img: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=500&q=80" } ] }; %>

        <main class="flex-grow max-w-[1400px] w-full mx-auto px-6 py-10">

            <!-- Header -->
            <div class="mb-10">
                <a href="/brands"
                    class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-black mb-4 transition">
                    ← Back to Brands
                </a>

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <h1 class="text-4xl md:text-5xl font-black text-black tracking-tight">
                            <%= currentBrand.name %> Collection
                        </h1>
                        <p class="mt-2 text-gray-500 text-sm font-medium">
                            Explore genuine <%= currentBrand.name %> devices and official accessories.
                        </p>
                    </div>

                    <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0">
                        <% currentBrand.seriesList.forEach((series, index)=> { %>
                            <button onclick="filterSeries('<%= series %>', this)"
                                class="series-btn px-4 py-2 text-xs font-bold rounded-full transition whitespace-nowrap <%= index === 0 ? 'bg-black text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                                <%= series %>
                            </button>
                            <% }); %>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6">
                <% currentBrand.products.forEach(product=> { %>
                    <div class="product-card bg-white border border-gray-100 rounded-3xl p-5 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group"
                        data-series="<%= product.series %>">

                        <div
                            class="relative bg-[#f4f4f4] rounded-2xl h-56 w-full flex items-center justify-center p-4 overflow-hidden mb-4">
                            <span
                                class="absolute top-3 right-3 text-[10px] font-bold bg-white text-black px-2.5 py-1 rounded-full shadow-sm">
                                <%= product.tag %>
                            </span>
                            <img src="<%= product.img %>" alt="<%= product.title %>"
                                class="h-40 object-contain group-hover:scale-105 transition duration-300 mix-blend-multiply">
                        </div>

                        <div>
                            <div class="text-xs text-gray-400 font-medium mb-1">
                                <%= product.series %>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 line-clamp-1 mb-2">
                                <%= product.title %>
                            </h3>
                            <div class="text-lg font-black text-black mb-4">$<%= product.price %>.00</div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 mt-auto">
                            <button onclick="addToCart('<%= product.title %>', <%= product.price %>)"
                                class="py-2.5 px-3 text-xs font-bold border border-gray-200 rounded-xl hover:bg-gray-100 active:scale-95 transition">
                                Add to Cart
                            </button>
                            <button onclick="directBuy('<%= product.title %>', <%= product.price %>)"
                                class="py-2.5 px-3 text-xs font-bold bg-black text-white rounded-xl hover:bg-gray-800 active:scale-95 transition">
                                Buy Now
                            </button>
                        </div>

                    </div>
                    <% }); %>
            </div>

        </main>

        <!-- CART MODAL -->
        <div id="cart-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-end">
            <div class="bg-white w-full max-w-md h-full p-6 flex flex-col justify-between shadow-2xl transition-all">
                <div>
                    <div class="flex items-center justify-between border-b pb-4 mb-4">
                        <h2 class="text-xl font-black">Your Cart</h2>
                        <button onclick="toggleCartModal()"
                            class="text-gray-400 hover:text-black text-xl font-bold">✕</button>
                    </div>

                    <div id="cart-items-container" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
                        <p id="empty-cart-msg" class="text-gray-400 text-sm text-center py-10">Your cart is currently
                            empty.</p>
                    </div>
                </div>

                <div class="border-t pt-4">
                    <div class="flex justify-between items-center text-lg font-black mb-4">
                        <span>Total:</span>
                        <span id="cart-total-price">$0.00</span>
                    </div>
                    <button onclick="checkoutCart()"
                        class="w-full py-3 bg-black text-white font-bold rounded-2xl hover:bg-gray-800 transition">
                        Proceed to Pay
                    </button>
                </div>
            </div>
        </div>

        <!-- PAYMENT QR MODAL -->
        <div id="payment-modal"
            class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white w-full max-w-sm rounded-3xl p-6 text-center shadow-2xl relative">
                <button onclick="closeModal('payment-modal')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-black font-bold">✕</button>

                <h3 class="text-xl font-black text-black">Scan to Pay</h3>
                <p class="text-xs text-gray-500 mt-1 mb-4">Scan QR code using KPay, WavePay or Mobile Banking</p>

                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 inline-block mb-4">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=STUFFSUS-PAYMENT-DEMO"
                        alt="Payment QR" class="w-44 h-44 mx-auto rounded-lg">
                </div>

                <div class="bg-gray-100 p-3 rounded-xl mb-4">
                    <span class="text-xs text-gray-500 block">Total Payable Amount</span>
                    <span id="payment-amount" class="text-2xl font-black text-black">$0.00</span>
                </div>

                <button onclick="simulateScanPayment()"
                    class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl transition">
                    Simulate QR Scan Completed
                </button>
            </div>
        </div>

        <!-- PAYMENT RECEIPT SLIP MODAL -->
        <div id="slip-modal"
            class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white w-full max-w-sm rounded-3xl p-6 text-center shadow-2xl relative">
                <div
                    class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3 font-bold text-xl">
                    ✓
                </div>

                <h3 class="text-xl font-black text-gray-900">Payment Successful!</h3>
                <p class="text-xs text-emerald-600 font-semibold mb-6">Official Purchase Receipt</p>

                <div class="bg-gray-50 rounded-2xl p-4 text-left text-xs space-y-2 mb-6 border border-gray-100">
                    <div class="flex justify-between text-gray-400">
                        <span>Transaction ID</span>
                        <span id="slip-txid" class="font-bold text-gray-800">#STF-982341</span>
                    </div>
                    <div class="flex justify-between text-gray-400">
                        <span>Date</span>
                        <span id="slip-date" class="font-bold text-gray-800">Today</span>
                    </div>
                    <div class="border-t border-gray-200 my-2"></div>
                    <div class="flex justify-between text-gray-600 font-semibold">
                        <span>Items Purchased</span>
                        <span id="slip-items-count">1 Item</span>
                    </div>
                    <div class="flex justify-between text-black font-black text-sm pt-1">
                        <span>Amount Paid</span>
                        <span id="slip-total">$0.00</span>
                    </div>
                </div>

                <button onclick="closeModal('slip-modal')"
                    class="w-full py-3 bg-black text-white font-bold rounded-2xl hover:bg-gray-800 transition">
                    Done & Close
                </button>
            </div>
        </div>

        <footer class="border-t border-gray-200 py-6 text-center text-xs text-gray-400 mt-auto">
            <p>Copyright © 2026 Stuffsus. All Rights Reserved.</p>
        </footer>

        <script>
            let cart = [];
            let currentPayAmount = 0;

            function filterSeries(seriesName, btnElement) {
                document.querySelectorAll('.series-btn').forEach(btn => {
                    btn.classList.remove('bg-black', 'text-white');
                    btn.classList.add('bg-gray-100', 'text-gray-600');
                });
                btnElement.classList.remove('bg-gray-100', 'text-gray-600');
                btnElement.classList.add('bg-black', 'text-white');

                document.querySelectorAll('.product-card').forEach(card => {
                    if (seriesName === 'All' || card.dataset.series === seriesName) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            function addToCart(title, price) {
                cart.push({ title, price });
                updateCartUI();
            }

            function updateCartUI() {
                const badge = document.getElementById('cart-badge');
                const container = document.getElementById('cart-items-container');
                const totalPriceEl = document.getElementById('cart-total-price');

                if (cart.length > 0) {
                    badge.innerText = cart.length;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }

                if (cart.length === 0) {
                    container.innerHTML = `<p class="text-gray-400 text-sm text-center py-10">Your cart is currently empty.</p>`;
                    totalPriceEl.innerText = `$0.00`;
                    return;
                }

                let total = 0;
                container.innerHTML = '';
                cart.forEach((item, index) => {
                    total += item.price;
                    container.innerHTML += `
          <div class="flex items-center justify-between bg-gray-50 p-3 rounded-2xl border border-gray-100">
            <div>
              <h4 class="text-xs font-bold text-gray-900">${item.title}</h4>
              <span class="text-xs font-extrabold text-black">$${item.price}.00</span>
            </div>
            <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 text-xs font-bold">Remove</button>
          </div>
        `;
                });

                totalPriceEl.innerText = `$${total}.00`;
                currentPayAmount = total;
            }

            function removeFromCart(index) {
                cart.splice(index, 1);
                updateCartUI();
            }

            function toggleCartModal() {
                document.getElementById('cart-modal').classList.toggle('hidden');
            }

            function directBuy(title, price) {
                currentPayAmount = price;
                cart = [{ title, price }];
                updateCartUI();
                openPaymentQR(price);
            }

            function checkoutCart() {
                if (cart.length === 0) return alert("Your cart is empty!");
                toggleCartModal();
                openPaymentQR(currentPayAmount);
            }

            function openPaymentQR(amount) {
                document.getElementById('payment-amount').innerText = `$${amount}.00`;
                document.getElementById('payment-modal').classList.remove('hidden');
            }

            function simulateScanPayment() {
                closeModal('payment-modal');

                document.getElementById('slip-txid').innerText = '#STF-' + Math.floor(100000 + Math.random() * 900000);
                document.getElementById('slip-date').innerText = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                document.getElementById('slip-items-count').innerText = `${cart.length} Item(s)`;
                document.getElementById('slip-total').innerText = `$${currentPayAmount}.00`;

                cart = [];
                updateCartUI();

                document.getElementById('slip-modal').classList.remove('hidden');
            }

            function closeModal(modalId) {
                document.getElementById(modalId).classList.add('hidden');
            }
        </script>

</body>

</html>