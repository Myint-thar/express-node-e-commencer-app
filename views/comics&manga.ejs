<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comics & Manga Collection - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

 
  <script id="products-data" type="application/json">
    <%- JSON.stringify(products || []) %>
  </script>
  <script>
    window.SERVER_PRODUCTS = JSON.parse(document.getElementById('products-data').textContent);
  </script>

  <div x-data="comicsApp()" class="flex-grow">
    
    <!-- Shared Navbar Include -->
    <%- include('partials/navbar') %>

    <!-- Header Section -->
    <div class="bg-slate-900 text-white py-12 px-8 border-b border-orange-500/30">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <div class="flex items-center gap-3">
            <span class="text-3xl">📚</span>
            <h1 class="text-3xl font-black tracking-wide">COMICS & MANGA</h1>
          </div>
          <p class="text-xs text-slate-400 mt-2">Explore top Japanese Manga, Western Comics, and Graphic Novels.</p>
        </div>
        
        <!-- Total Items Counter Badge (130+ Items) -->
        <div class="bg-slate-800 border border-slate-700 px-4 py-2 rounded-lg flex items-center gap-3">
          <span class="text-xs text-slate-400 font-bold uppercase">Total Card List</span>
          <span class="bg-orange-500 text-white text-xs font-black px-2.5 py-1 rounded-md">
            <%= products.length %>+ Items
          </span>
        </div>
      </div>
    </div>

    <!-- Main Content Section -->
    <main class="max-w-7xl mx-auto py-10 px-6">
      
      <!-- Category Filter Bar -->
      <div class="flex flex-wrap justify-between items-center pb-6 border-b border-gray-200 mb-8 gap-4">
        <div class="flex gap-2">
          <button @click="filterType = 'all'" :class="filterType === 'all' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-gray-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">All (<%= products.length %>)</button>
          <button @click="filterType = 'Manga'" :class="filterType === 'Manga' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-gray-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">Manga Only</button>
          <button @click="filterType = 'Comic Book'" :class="filterType === 'Comic Book' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-gray-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">Comic Books</button>
        </div>
        
        <!-- Search Input -->
        <div class="relative w-full md:w-64">
          <input type="text" x-model="searchQuery" placeholder="Search comics..." class="w-full bg-white border border-gray-300 rounded-lg py-1.5 px-3 pl-8 text-xs focus:outline-none focus:border-orange-500">
          <span class="absolute left-2.5 top-2 text-gray-400 text-xs">🔍</span>
        </div>
      </div>

      <!-- Product Cards Grid (130 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
        <template x-for="(product, idx) in filteredProducts" :key="product._id">
          
          <div @click="openModal(idx)" class="bg-white border border-gray-200 rounded-lg p-3 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer relative group">
            
            <!-- Badge & Wishlist -->
            <div class="flex justify-between items-start z-10">
              <span x-show="product.badge" x-text="product.badge" class="bg-orange-500 text-white text-[8px] font-black px-1.5 py-0.5 rounded uppercase"></span>
              <span x-show="!product.badge"></span>

              <form :action="'/wishlist/add/' + product._id" method="POST" @click.stop>
                <input type="hidden" name="title" :value="product.title">
                <input type="hidden" name="price" :value="product.price">
                <input type="hidden" name="image" :value="product.image">
                <button type="submit" class="text-gray-300 hover:text-red-500 transition text-sm">❤️</button>
              </form>
            </div>

            <!-- Thumbnail Image -->
            <div class="h-48 flex items-center justify-center my-2 overflow-hidden bg-gray-50 rounded">
              <img :src="product.image" :alt="product.title" class="max-h-full object-cover group-hover:scale-105 transition duration-300">
            </div>

            <!-- Book Information -->
            <div class="mt-1">
              <span class="text-[9px] text-orange-600 font-bold uppercase tracking-wider" x-text="product.category"></span>
              <h3 class="font-bold text-xs text-slate-800 line-clamp-1 mt-0.5" x-text="product.title"></h3>
              
              <div class="flex items-baseline gap-2 mt-1">
                <span class="text-orange-500 font-black text-xs" x-text="'$' + product.price"></span>
                <span class="text-gray-400 line-through text-[10px]" x-show="product.oldPrice" x-text="'$' + product.oldPrice"></span>
              </div>
            </div>

            <!-- Add to Cart -->
            <form :action="'/cart/add/' + product._id" method="POST" class="mt-3" @click.stop>
              <input type="hidden" name="title" :value="product.title">
              <input type="hidden" name="price" :value="product.price">
              <input type="hidden" name="image" :value="product.image">
              <button type="submit" class="w-full bg-slate-900 text-white font-bold py-1.5 rounded text-[10px] hover:bg-orange-500 transition">
                🛒 ADD TO CART
              </button>
            </form>
          </div>

        </template>
      </div>

    </main>

    <!-- Details Modal -->
    <div x-show="isModalOpen" x-cloak class="fixed inset-0 bg-slate-900/80 z-[100] flex items-center justify-center p-4 backdrop-blur-sm" @click.self="closeModal()">
      <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] flex flex-col md:flex-row relative overflow-hidden" x-transition>
        <button @click="closeModal()" class="absolute top-3 right-3 z-10 w-7 h-7 bg-gray-100 hover:bg-red-100 text-gray-600 hover:text-red-500 rounded-full flex items-center justify-center font-bold text-xs">✕</button>

        <div class="w-full md:w-1/2 bg-gray-100 flex items-center justify-center p-6">
          <img :src="currentProduct.image" :alt="currentProduct.title" class="max-h-72 object-contain shadow-md rounded">
        </div>

        <div class="w-full md:w-1/2 p-6 flex flex-col justify-between">
          <div>
            <span class="text-[9px] bg-orange-100 text-orange-600 px-2 py-0.5 rounded font-bold uppercase" x-text="currentProduct.category"></span>
            <h2 class="text-lg font-black text-slate-900 mt-2" x-text="currentProduct.title"></h2>
            
            <div class="flex items-end gap-2 my-2">
              <span class="text-xl font-black text-orange-500" x-text="'$' + currentProduct.price"></span>
              <span class="text-xs text-gray-400 line-through mb-0.5" x-show="currentProduct.oldPrice" x-text="'$' + currentProduct.oldPrice"></span>
            </div>

            <p class="text-xs text-gray-600 leading-relaxed mb-4" x-text="currentProduct.description"></p>
          </div>

          <form :action="'/cart/add/' + currentProduct._id" method="POST">
             <input type="hidden" name="title" :value="currentProduct.title">
             <input type="hidden" name="price" :value="currentProduct.price">
             <input type="hidden" name="image" :value="currentProduct.image">
             <button type="submit" class="w-full bg-orange-500 text-white font-bold py-2.5 rounded hover:bg-orange-600 transition text-xs">
               BUY THIS BOOK NOW
             </button>
          </form>
        </div>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('comicsApp', () => ({
        products: window.SERVER_PRODUCTS || [],
        filterType: 'all',
        searchQuery: '',
        isModalOpen: false,
        currentIndex: 0,

        get filteredProducts() {
          return this.products.filter(p => {
            const matchesType = this.filterType === 'all' || p.category === this.filterType;
            const matchesSearch = p.title.toLowerCase().includes(this.searchQuery.toLowerCase());
            return matchesType && matchesSearch;
          });
        },
        openModal(idx) {
          this.currentIndex = idx;
          this.isModalOpen = true;
        },
        closeModal() {
          this.isModalOpen = false;
        },
        get currentProduct() {
          return this.filteredProducts[this.currentIndex] || {};
        }
      }));
    });
  </script>
</body>
</html>