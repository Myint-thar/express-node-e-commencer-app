<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comics & Manga - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- Backend Data Injection -->
  <script id="manga-data" type="application/json">
    <%- JSON.stringify(mangaItems || []) %>
  </script>
  <script>
    window.SERVER_MANGA = JSON.parse(document.getElementById('manga-data').textContent);
  </script>

  <div x-data="mangaApp()" class="flex-grow flex flex-col">

    <!-- Navbar Component -->
    <%- include('partials/navbar') %>

    <main class="max-w-7xl mx-auto py-10 px-6 flex-grow w-full">
      
      <!-- Top Header & Search Box Section -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-200">
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>📚</span> COMICS & MANGA
          </h1>
          <p class="text-xs text-slate-500 mt-1">Browse and read your favorite manga volumes online.</p>
        </div>

        <!-- LIVE SEARCH BOX -->
        <div class="relative w-full md:w-80">
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Search title, genre, or author..."
            class="w-full bg-white border border-slate-300 rounded-xl py-2.5 pl-10 pr-10 text-xs font-semibold focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 shadow-sm transition"
          >
          <!-- Search Icon -->
          <span class="absolute left-3 top-2.5 text-slate-400 text-sm">🔍</span>

          <!-- Clear Search (X) Button -->
          <button
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''"
            class="absolute right-3 top-2.5 text-slate-400 hover:text-red-500 text-xs font-bold bg-slate-100 hover:bg-slate-200 rounded-full w-5 h-5 flex items-center justify-center transition"
          >✕</button>
        </div>
      </div>

      <!-- Search Results Counter Info -->
      <div class="mb-4 text-xs font-bold text-slate-500 flex justify-between items-center" x-show="searchQuery" x-cloak>
        <span>Search results for: "<span class="text-orange-500" x-text="searchQuery"></span>"</span>
        <span x-text="filteredManga.length + ' item(s) found'"></span>
      </div>

      <!-- Manga Items Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5" x-show="filteredManga.length > 0">
        <template x-for="item in filteredManga" :key="item.id">
          
          <div class="bg-white border border-slate-200 rounded-xl p-3 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition duration-300">
            <div>
              <!-- Cover Image -->
              <div class="h-52 bg-slate-100 rounded-lg overflow-hidden flex items-center justify-center mb-3 relative">
                <img :src="item.cover" :alt="item.title" class="h-full w-full object-cover">
                <span class="absolute top-2 left-2 bg-slate-900/80 text-white text-[9px] font-bold px-2 py-0.5 rounded backdrop-blur" x-text="item.genre"></span>
              </div>

              <!-- Details -->
              <h3 class="font-bold text-xs text-slate-900 line-clamp-1" x-text="item.title"></h3>
              <p class="text-[10px] text-slate-400 mt-0.5" x-text="'Author: ' + item.author"></p>
              
              <div class="mt-2 font-black text-orange-500 text-sm" x-text="'$' + item.price"></div>
            </div>

            <!-- Read Button -->
            <a :href="'/manga/read/' + item.id" class="mt-3 block text-center bg-slate-900 hover:bg-orange-500 text-white font-bold py-2 rounded-lg text-xs transition uppercase tracking-wider">
              📖 READ NOW
            </a>
          </div>

        </template>
      </div>

      <!-- No Search Results Found State -->
      <div x-show="filteredManga.length === 0" x-cloak class="text-center py-16 bg-white rounded-2xl border border-slate-200 my-6 shadow-sm">
        <span class="text-4xl block mb-2">🔍</span>
        <h3 class="text-sm font-bold text-slate-800">No Manga Found</h3>
        <p class="text-xs text-slate-400 mt-1">No title or genre matches "<span x-text="searchQuery"></span>"</p>
        <button @click="searchQuery = ''" class="mt-4 bg-orange-500 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-orange-600 transition">
          Clear Search Filter
        </button>
      </div>

    </main>

  </div>

  <!-- Alpine.js Live Search Logic -->
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('mangaApp', () => ({
        searchQuery: '',
        mangaList: window.SERVER_MANGA || [],

        // Title, Author သို့မဟုတ် Genre ဖြင့် Filter လုပ်ပေးသော Logic
        get filteredManga() {
          if (!this.searchQuery.trim()) {
            return this.mangaList;
          }
          const query = this.searchQuery.toLowerCase().trim();
          return this.mangaList.filter(item => {
            return item.title.toLowerCase().includes(query) ||
                   item.genre.toLowerCase().includes(query) ||
                   (item.author && item.author.toLowerCase().includes(query));
          });
        }
      }));
    });
  </script>
</body>
</html>