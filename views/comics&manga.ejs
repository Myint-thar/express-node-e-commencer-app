<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comics & Manga - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Backend Data Injection -->
  <script id="manga-data" type="application/json">
    <%- JSON.stringify(mangaItems || []) %>
  </script>
  <script>
    window.SERVER_MANGA = JSON.parse(document.getElementById('manga-data').textContent);
  </script>

  <div x-data="mangaApp()" class="flex-grow flex flex-col">

    <%- include('partials/navbar') %>

    <main class="max-w-7xl mx-auto py-10 px-6 flex-grow w-full">
      
      <!-- Top Header & Search Box Section -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-800">
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
            <span>📚</span> COMICS & MANGA
          </h1>
          <p class="text-xs text-slate-400 mt-1">Browse and read your favorite manga volumes online.</p>
        </div>

        <!-- SEARCH BOX -->
        <div class="relative w-full md:w-80">
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Search title, genre, or author..."
            class="w-full bg-slate-900 border border-slate-800 rounded-xl py-2.5 pl-10 pr-10 text-xs font-semibold text-white focus:outline-none focus:border-orange-500 shadow-sm transition"
          >
          <span class="absolute left-3 top-2.5 text-slate-400 text-sm">🔍</span>
          <button
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''"
            class="absolute right-3 top-2.5 text-slate-400 hover:text-red-500 text-xs font-bold bg-slate-800 rounded-full w-5 h-5 flex items-center justify-center transition"
          >✕</button>
        </div>
      </div>

      <!-- Manga Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5" x-show="filteredManga.length > 0">
        <template x-for="item in filteredManga" :key="item.id">
          
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-col justify-between hover:border-orange-500/50 hover:-translate-y-1 transition duration-300 shadow-xl">
            <div>
              <!-- Cover Image (FIXED: item.image || item.cover) -->
              <div class="h-56 bg-slate-800 rounded-lg overflow-hidden flex items-center justify-center mb-3 relative">
                <img 
                  :src="item.image || item.cover || 'https://placehold.co/300x420/1e293b/ffffff?text=Manga+Cover'" 
                  :alt="item.title" 
                  class="h-full w-full object-cover"
                  @error="$el.src='https://placehold.co/300x420/1e293b/ffffff?text=Image+Not+Found'"
                >
                <span class="absolute top-2 left-2 bg-slate-950/80 text-orange-400 text-[9px] font-bold px-2 py-0.5 rounded border border-orange-500/30" x-text="item.genre || 'Action / Adventure'"></span>
              </div>

              <!-- Details -->
              <h3 class="font-bold text-xs text-white line-clamp-1" x-text="item.title"></h3>
              <p class="text-[10px] text-slate-400 mt-0.5" x-text="'Author: ' + (item.author || 'Eiichiro Oda')"></p>
              
              <div class="mt-2 font-black text-orange-400 text-sm" x-text="'$' + item.price"></div>
            </div>

            <!-- BUTTONS: READ NOW & BUY NOW -->
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a :href="'/manga/read/' + item.id" class="text-center bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold py-2 rounded-lg text-[10px] transition uppercase tracking-wider flex items-center justify-center gap-1">
                📖 Read
              </a>
              <a :href="'/eslip/' + item.id" class="text-center bg-orange-500 hover:bg-orange-600 text-white font-black py-2 rounded-lg text-[10px] transition uppercase tracking-wider shadow-md flex items-center justify-center gap-1">
                🛒 Buy
              </a>
            </div>

          </div>

        </template>
      </div>

    </main>

  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('mangaApp', () => ({
        searchQuery: '',
        mangaList: window.SERVER_MANGA || [],
        get filteredManga() {
          if (!this.searchQuery.trim()) return this.mangaList;
          const query = this.searchQuery.toLowerCase().trim();
          return this.mangaList.filter(item => {
            return (item.title && item.title.toLowerCase().includes(query)) ||
                   (item.genre && item.genre.toLowerCase().includes(query)) ||
                   (item.author && item.author.toLowerCase().includes(query));
          });
        }
      }));
    });
  </script>
</body>
</html>