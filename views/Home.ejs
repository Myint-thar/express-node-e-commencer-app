<%- include('partials/header') %>

<main>
  <!-- 1. HERO BANNER SECTION -->
  <section class="bg-slate-900 text-white py-16 px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-4 max-w-lg z-10">
        <span class="bg-orange-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">New Season Arrivals</span>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight leading-tight">
          DISCOVER QUALITY <span class="text-orange-500">PRODUCTS</span>
        </h1>
        <p class="text-gray-400 text-xs md:text-sm">Explore our trending collections with daily limited deals and fast delivery options.</p>
        <div class="pt-2 flex gap-3">
          <a href="/products" class="bg-orange-500 text-white font-bold text-xs px-6 py-3 rounded hover:bg-orange-600 transition inline-block">SHOP NOW →</a>
          <a href="/products?sort=new" class="border border-gray-600 text-white font-bold text-xs px-6 py-3 rounded hover:bg-slate-800 transition inline-block">EXPLORE MORE</a>
        </div>
      </div>
      <div class="text-9xl opacity-80">
        📦
      </div>
    </div>
  </section>

  <!-- 2. VALUE PROPOSITIONS / TRUST BADGES -->
  <section class="bg-white border-b py-6 px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-center md:text-left">
      <div class="flex items-center gap-3 justify-center md:justify-start">
        <span class="text-2xl">🚀</span>
        <div>
          <h4 class="font-bold text-xs">Fast Shipping</h4>
          <p class="text-[10px] text-gray-500">Across the country</p>
        </div>
      </div>
      <div class="flex items-center gap-3 justify-center md:justify-start">
        <span class="text-2xl">🛡️</span>
        <div>
          <h4 class="font-bold text-xs">100% Secure Checkout</h4>
          <p class="text-[10px] text-gray-500">Trusted local payments</p>
        </div>
      </div>
      <div class="flex items-center gap-3 justify-center md:justify-start">
        <span class="text-2xl">🔄</span>
        <div>
          <h4 class="font-bold text-xs">Easy Returns</h4>
          <p class="text-[10px] text-gray-500">7-Day return policy</p>
        </div>
      </div>
      <div class="flex items-center gap-3 justify-center md:justify-start">
        <span class="text-2xl">💬</span>
        <div>
          <h4 class="font-bold text-xs">24/7 Support</h4>
          <p class="text-[10px] text-gray-500">Dedicated assistance</p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto py-12 px-8 space-y-16">
    
    <!-- 3. SHOP BY CATEGORY -->
    <section>
      <div class="flex justify-between items-end mb-6">
        <div>
          <h2 class="font-black text-xl text-slate-900">SHOP BY CATEGORY</h2>
          <p class="text-xs text-gray-500">Find exactly what you are looking for</p>
        </div>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <a href="/products/category/<%= cat.name.toLowerCase() %>" class="bg-white border rounded-lg p-5 text-center hover:border-orange-500 hover:shadow-md transition group">
              <div class="text-3xl mb-2 group-hover:scale-110 transition duration-200"><%= cat.icon %></div>
              <h3 class="font-bold text-xs text-slate-800"><%= cat.name %></h3>
              <span class="text-[10px] text-gray-400"><%= cat.count %></span>
            </a>
          <% }) %>
        <% } %>
      </div>
    </section>

    <!-- 4. FLASH SALE SECTION -->
    <section class="bg-orange-50 border border-orange-100 rounded-lg p-6">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-2">
        <div>
          <span class="bg-red-500 text-white text-[9px] font-bold px-2 py-0.5 rounded">LIMITED TIME</span>
          <h2 class="font-black text-xl text-slate-900 mt-1">FLASH SALE DEALS</h2>
        </div>
        <a href="/products" class="text-xs font-bold text-orange-600 hover:underline">View All Deals →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% if (flashSaleProducts && flashSaleProducts.length > 0) { %>
          <% flashSaleProducts.forEach(product => { %>
            <div class="bg-white border rounded-md p-4 flex flex-col justify-between hover:shadow-lg transition">
              <div class="h-40 flex items-center justify-center bg-gray-50 rounded mb-3">
                <img src="<%= product.image || '/uploads/default.jpg' %>" alt="<%= product.title || product.name %>" class="max-h-full object-contain">
              </div>
              <div>
                <h3 class="font-bold text-xs text-slate-800 line-clamp-1"><%= product.title || product.name %></h3>
                <div class="flex items-baseline gap-2 mt-2">
                  <span class="text-orange-500 font-bold text-sm">$<%= product.price %></span>
                  <span class="text-gray-400 line-through text-xs">$<%= (parseFloat(product.price) * 1.2).toFixed(2) %></span>
                </div>
              </div>
              <form action="/cart/add/<%= product.id || product._id %>" method="POST" class="mt-4">
                <button type="submit" class="w-full bg-slate-900 text-white font-bold py-2 rounded text-xs hover:bg-orange-500 transition">
                  ADD TO CART
                </button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-center text-xs text-gray-400 py-6">No flash deals currently available.</p>
        <% } %>
      </div>
    </section>

    <!-- 5. BEST SELLERS / FEATURED PRODUCTS -->
    <section>
      <div class="flex justify-between items-end mb-6 border-b pb-3">
        <h2 class="font-black text-xl text-slate-900">BEST SELLERS</h2>
        <a href="/products" class="text-xs font-bold text-orange-500 hover:underline">Explore Store →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="bg-white border rounded-md p-4 flex flex-col justify-between hover:shadow-md transition">
              <div class="h-44 flex items-center justify-center bg-gray-50 rounded mb-3">
                <img src="<%= product.image || '/uploads/default.jpg' %>" alt="<%= product.title || product.name %>" class="max-h-full object-contain">
              </div>
              <div>
                <h3 class="font-bold text-xs text-slate-800 line-clamp-1"><%= product.title || product.name %></h3>
                <div class="flex items-baseline gap-2 mt-2">
                  <span class="text-slate-900 font-bold text-sm">$<%= product.price %></span>
                </div>
              </div>
              <form action="/cart/add/<%= product.id || product._id %>" method="POST" class="mt-4">
                <button type="submit" class="w-full border border-slate-900 text-slate-900 font-bold py-2 rounded text-xs hover:bg-slate-900 hover:text-white transition">
                  ADD TO CART
                </button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-center text-xs text-gray-400 py-8">No products available in best sellers.</p>
        <% } %>
      </div>
    </section>

  </div>
</main>

<%- include('partials/footer') %>