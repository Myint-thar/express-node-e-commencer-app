<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Electronics & Gadgets - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

  <script id="products-data" type="application/json">
    <%- JSON.stringify(products || []) %>
  </script>
  <script>
    window.SERVER_PRODUCTS = JSON.parse(document.getElementById('products-data').textContent);
  </script>

  <div x-data="electronicsApp()" class="flex-grow">
    
    <!-- Navbar Component -->
    <%- include('partials/navbar') %>

    <!-- Electronics Banner Header -->
    <div class="bg-slate-950 text-white py-12 px-8 border-b border-orange-500/40">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <div class="flex items-center gap-3">
            <span class="text-3xl">🔌</span>
            <h1 class="text-3xl font-black tracking-wider text-orange-500">ELECTRONICS & TECH</h1>
          </div>
          <p class="text-xs text-slate-400 mt-2">Discover high-performance gadgets, audio gear, and smart devices.</p>
        </div>
        
        <!-- Total Items Counter -->
        <div class="bg-slate-900 border border-slate-800 px-4 py-2 rounded-xl flex items-center gap-3 shadow-lg">
          <span class="text-xs text-slate-400 font-bold uppercase">Total Gadgets</span>
          <span class="bg-orange-500 text-white text-xs font-black px-2.5 py-1 rounded-md">
            <%= products.length %>+ Items
          </span>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <main class="max-w-7xl mx-auto py-10 px-6">
      
      <!-- Filter Bar & Search -->
      <div class="flex flex-wrap justify-between items-center pb-6 border-b border-slate-200 mb-8 gap-4">
        <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
          <button @click="filterColor = 'all'" :class="filterColor === 'all' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-slate-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">All Devices (<%= products.length %>)</button>
          <button @click="filterColor = 'Black'" :class="filterColor === 'Black' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-slate-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">Black Series</button>
          <button @click="filterColor = 'Silver'" :class="filterColor === 'Silver' ? 'bg-orange-500 text-white' : 'bg-white text-slate-700 border hover:bg-slate-100'" class="px-4 py-1.5 rounded-full text-xs font-bold transition">Silver Series</button>
        </div>
        
        <!-- Search Box -->
        <div class="relative w-full md:w-72">
          <input type="text" x-model="searchQuery" placeholder="Search gadgets..." class="w-full bg-white border border-slate-300 rounded-lg py-1.5 px-3 pl-8 text-xs focus:outline-none focus:border-orange-500">
          <span class="absolute left-2.5 top-2 text-slate-400 text-xs">🔍</span>
        </div>
      </div>

      <!-- Electronics Cards (120 Cards) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-6">
        <template x-for="(product, idx) in filteredProducts" :key="product._id">
          
          <div @click="openModal(idx)" class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer relative group">
            
            <div class="flex justify-between items-start z-10">
              <span x-show="product.badge" x-text="product.badge" class="bg-slate-900 text-orange-400 border border-orange-500/30 text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-wider"></span>
              <span x-show="!product.badge"></span>

              <form :action="'/wishlist/add/' + product._id" method="POST" @click.stop>
                <input type="hidden" name="title" :value="product.title">
                <input type="hidden" name="price" :value="product.price">
                <input type="hidden" name="image" :value="product.image">
                <button type="submit" class="text-slate-300 hover:text-red-500 transition text-base">❤️</button>
              </form>
            </div>

            <div class="h-44 flex items-center justify-center my-3 overflow-hidden bg-slate-50 rounded-lg p-2">
              <img :src="product.image" :alt="product.title" class="max-h-full object-contain group-hover:scale-105 transition duration-300">
            </div>

            <div>
              <div class="flex items-center justify-between text-[9px] text-slate-400 font-bold uppercase mb-1">
                <span x-text="product.category"></span>
                <span class="text-slate-500 font-semibold" x-text="product.color"></span>
              </div>
              <h3 class="font-bold text-xs text-slate-900 line-clamp-1" x-text="product.title"></h3>
              
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-orange-500 font-black text-sm" x-text="'$' + product.price"></span>
                <span class="text-slate-400 line-through text-xs" x-show="product.oldPrice" x-text="'$' + product.oldPrice"></span>
              </div>
            </div>

            <form :action="'/cart/add/' + product._id" method="POST" class="mt-4" @click.stop>
              <input type="hidden" name="title" :value="product.title">
              <input type="hidden" name="price" :value="product.price">
              <input type="hidden" name="image" :value="product.image">
              <button type="submit" class="w-full bg-slate-900 text-white font-bold py-2 rounded-lg text-xs hover:bg-orange-500 transition duration-200">
                ⚡ ADD TO CART
              </button>
            </form>
          </div>

        </template>
      </div>

    </main>

    <!-- Details Modal -->
    <div x-show="isModalOpen" x-cloak class="fixed inset-0 bg-slate-950/80 z-[100] flex items-center justify-center p-4 backdrop-blur-sm" @click.self="closeModal()">
      <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full max-h-[90vh] flex flex-col md:flex-row relative overflow-hidden" x-transition>
        <button @click="closeModal()" class="absolute top-3 right-3 z-10 w-8 h-8 bg-slate-100 hover:bg-red-100 text-slate-600 hover:text-red-500 rounded-full flex items-center justify-center font-bold text-xs">✕</button>

        <div class="w-full md:w-1/2 bg-slate-100 flex items-center justify-center p-6">
          <img :src="currentProduct.image" :alt="currentProduct.title" class="max-h-72 object-contain drop-shadow-lg">
        </div>

        <div class="w-full md:w-1/2 p-6 flex flex-col justify-between">
          <div>
            <span class="text-[9px] bg-slate-900 text-orange-400 px-2.5 py-1 rounded-md font-bold uppercase tracking-wider" x-text="currentProduct.category"></span>
            <h2 class="text-xl font-black text-slate-900 mt-3" x-text="currentProduct.title"></h2>
            
            <div class="flex items-end gap-3 my-3">
              <span class="text-2xl font-black text-orange-500" x-text="'$' + currentProduct.price"></span>
              <span class="text-xs text-slate-400 line-through mb-1" x-show="currentProduct.oldPrice" x-text="'$' + currentProduct.oldPrice"></span>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed mb-4" x-text="currentProduct.description"></p>
            <div class="text-xs text-slate-500 font-semibold mb-4">Color Option: <span class="text-slate-900 font-bold" x-text="currentProduct.color"></span></div>
          </div>

          <form :action="'/cart/add/' + currentProduct._id" method="POST">
             <input type="hidden" name="title" :value="currentProduct.title">
             <input type="hidden" name="price" :value="currentProduct.price">
             <input type="hidden" name="image" :value="currentProduct.image">
             <button type="submit" class="w-full bg-orange-500 text-white font-bold py-3 rounded-lg hover:bg-orange-600 transition text-xs shadow-lg">
               BUY THIS ITEM NOW
             </button>
          </form>
        </div>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('electronicsApp', () => ({
        products: window.SERVER_PRODUCTS || [],
        filterColor: 'all',
        searchQuery: '',
        isModalOpen: false,
        currentIndex: 0,

        get filteredProducts() {
          return this.products.filter(p => {
            const matchesColor = this.filterColor === 'all' || p.color === this.filterColor;
            const matchesSearch = p.title.toLowerCase().includes(this.searchQuery.toLowerCase());
            return matchesColor && matchesSearch;
          });
        },
        openModal(idx) {
          this.currentIndex = idx;
          this.isModalOpen = true;
        },
        closeModal() {
          this.isModalOpen = false;
        },
        get currentProduct() {
          return this.filteredProducts[this.currentIndex] || {};
        }
      }));
    });
  </script>
</body>
</html>