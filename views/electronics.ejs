<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Electronics & Tech - FAMSWORLD</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Backend Data Injection (Variable Name များစွာအတွက် Fallback ရေးထားပါသည်) -->
  <script id="electronics-data" type="application/json">
    <%- JSON.stringify(locals.electronicsItems || locals.electronics || locals.products || []) %>
  </script>
  <script>
    window.SERVER_ELECTRONICS = JSON.parse(document.getElementById('electronics-data').textContent);
  </script>

  <div x-data="electronicsApp()" class="flex-grow flex flex-col">

    <%- include('partials/navbar') %>

    <main class="max-w-7xl mx-auto py-10 px-6 flex-grow w-full">
      
      <!-- Top Header & Search Box Section -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-800">
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
            <span>⚡</span> ELECTRONICS & TECH
          </h1>
          <p class="text-xs text-slate-400 mt-1">Discover high-performance gadgets, audio gear, and smart devices online.</p>
        </div>

        <!-- SEARCH BOX -->
        <div class="relative w-full md:w-80">
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Search title, brand, or specs..."
            class="w-full bg-slate-900 border border-slate-800 rounded-xl py-2.5 pl-10 pr-10 text-xs font-semibold text-white focus:outline-none focus:border-orange-500 shadow-sm transition"
          >
          <span class="absolute left-3 top-2.5 text-slate-400 text-sm">🔍</span>
          <button
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''"
            class="absolute right-3 top-2.5 text-slate-400 hover:text-red-500 text-xs font-bold bg-slate-800 rounded-full w-5 h-5 flex items-center justify-center transition"
          >✕</button>
        </div>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5" x-show="filteredProducts.length > 0">
        <template x-for="item in filteredProducts" :key="item.id">
          
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-col justify-between hover:border-orange-500/50 hover:-translate-y-1 transition duration-300 shadow-xl">
            <div>
              <!-- Product Image -->
              <div class="h-56 bg-slate-800 rounded-lg overflow-hidden flex items-center justify-center mb-3 relative">
                <img 
                  :src="item.image || item.cover || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500'" 
                  :alt="item.title" 
                  class="h-full w-full object-cover"
                  @error="$el.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500'"
                >
                <span 
                  class="absolute top-2 left-2 bg-slate-950/80 text-orange-400 text-[9px] font-bold px-2 py-0.5 rounded border border-orange-500/30" 
                  x-text="item.badge || item.brand || 'TECH'"
                ></span>
              </div>

              <!-- Details -->
              <h3 class="font-bold text-xs text-white line-clamp-1" x-text="item.title"></h3>
              <p class="text-[10px] text-slate-400 mt-0.5" x-text="'Brand: ' + (item.brand || 'Generic Tech')"></p>
              
              <div class="mt-2 font-black text-orange-400 text-sm" x-text="'$' + item.price"></div>
            </div>

            <!-- BUTTONS: VIEW & BUY NOW -->
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a :href="'/electronics/detail/' + item.id" class="text-center bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold py-2 rounded-lg text-[10px] transition uppercase tracking-wider flex items-center justify-center gap-1">
                ⚡ Details
              </a>
              <a :href="'/eslip/' + item.id" class="text-center bg-orange-500 hover:bg-orange-600 text-white font-black py-2 rounded-lg text-[10px] transition uppercase tracking-wider shadow-md flex items-center justify-center gap-1">
                🛒 Buy
              </a>
            </div>

          </div>

        </template>
      </div>

      <!-- Empty State -->
      <div x-show="filteredProducts.length === 0" class="text-center py-20 text-slate-500">
        <p class="text-sm font-semibold">No electronics found matching your search.</p>
      </div>

    </main>

  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('electronicsApp', () => ({
        searchQuery: '',
        productList: window.SERVER_ELECTRONICS || [],
        get filteredProducts() {
          if (!this.searchQuery.trim()) return this.productList;
          const query = this.searchQuery.toLowerCase().trim();
          return this.productList.filter(item => {
            return (item.title && item.title.toLowerCase().includes(query)) ||
                   (item.brand && item.brand.toLowerCase().includes(query)) ||
                   (item.category && item.category.toLowerCase().includes(query));
          });
        }
      }));
    });
  </script>
</body>
</html>