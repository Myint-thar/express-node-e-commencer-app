<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - FAMSWORLD</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans flex flex-col justify-between">

  <!-- Header -->
  <header class="bg-slate-900 border-b border-slate-800 py-4 px-6 flex justify-between items-center sticky top-0 z-50">
    <a href="/" class="text-orange-500 hover:text-orange-400 font-bold text-xs flex items-center gap-1 transition">
      ← BACK TO HOME
    </a>
    <h1 class="text-sm font-black text-white tracking-widest uppercase">CONTACT US</h1>
    <div class="w-16"></div>
  </header>

  <!-- Main Content -->
  <main class="max-w-xl w-full mx-auto p-6 md:p-8 flex-grow flex flex-col justify-center">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 shadow-2xl space-y-6">
      
      <div class="text-center space-y-2">
        <span class="text-xs bg-orange-500/10 text-orange-400 border border-orange-500/20 px-3 py-1 rounded-full font-bold uppercase">
          Get in Touch
        </span>
        <h2 class="text-2xl font-black text-white">Contact Our Team</h2>
        <p class="text-slate-400 text-xs">Have questions or feedback? Send us a message below.</p>
      </div>

      <!-- Contact Form (Action matches app.js /contact/send) -->
      <form action="/contact/send" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Your Name</label>
          <input type="text" name="name" required placeholder="Enter your name" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-100 focus:outline-none focus:border-orange-500 transition">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Contact Info (Email / Phone)</label>
          <input type="text" name="contact" required placeholder="example@gmail.com / 09xxxxxxxxx" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-100 focus:outline-none focus:border-orange-500 transition">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Message</label>
          <textarea name="message" rows="4" required placeholder="Write your message here..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-100 focus:outline-none focus:border-orange-500 transition resize-none"></textarea>
        </div>

        <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-black text-xs py-3 rounded-xl uppercase tracking-wider transition shadow-lg shadow-orange-500/20">
          Send Message
        </button>
      </form>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-slate-900 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
    &copy; <%= new Date().getFullYear() %> FAMSWORLD. All rights reserved.
  </footer>

</body>
</html>