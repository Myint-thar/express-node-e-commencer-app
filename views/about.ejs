<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About Us - FAMSWORLD</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">

  <!-- Navbar Component Include -->
  <%- include('partials/navbar') %>

  <!-- Hero Header -->
  <div class="bg-slate-900 text-white py-16 text-center">
    <h1 class="text-3xl font-black">ABOUT <span class="text-orange-500">FAMSWORLD</span></h1>
    <p class="text-gray-400 text-xs mt-2">Quality Products. Trusted By Thousands.</p>
  </div>

  <!-- Content Section -->
  <main class="max-w-5xl mx-auto py-12 px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Our Story & Mission</h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          FAMSWORLD was founded with a simple mission: to provide high-quality lifestyle, tech, and daily essential products directly to our customers at unbeatable prices.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed">
          We carefully select every item in our inventory to ensure reliability, durability, and customer satisfaction.
        </p>
      </div>
      <div class="bg-slate-200 h-64 rounded-lg flex items-center justify-center text-slate-400 font-bold">
        [ About Us Image Placeholder ]
      </div>
    </div>

    <!-- 4 Key Stats / Features Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center border-t pt-12">
      <div class="p-4 bg-white shadow-sm rounded border">
        <h3 class="text-2xl font-black text-orange-500">10K+</h3>
        <p class="text-xs text-gray-500 mt-1">Happy Customers</p>
      </div>
      <div class="p-4 bg-white shadow-sm rounded border">
        <h3 class="text-2xl font-black text-orange-500">4.8</h3>
        <p class="text-xs text-gray-500 mt-1">Customer Rating</p>
      </div>
      <div class="p-4 bg-white shadow-sm rounded border">
        <h3 class="text-2xl font-black text-orange-500">500+</h3>
        <p class="text-xs text-gray-500 mt-1">Quality Products</p>
      </div>
      <div class="p-4 bg-white shadow-sm rounded border">
        <h3 class="text-2xl font-black text-orange-500">100%</h3>
        <p class="text-xs text-gray-500 mt-1">Secure Checkout</p>
      </div>
    </div>
  </main>

  <!-- Footer Component Include -->
  <%- include('partials/footer') %>

</body>
</html>