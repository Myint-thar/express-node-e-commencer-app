<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col" x-data="{ activeImage: null, activePageNum: 1 }">

  <!-- Header Navigation -->
  <header class="w-full bg-slate-900 border-b border-slate-800 py-3.5 px-6 sticky top-0 z-40 flex items-center justify-between shadow-lg">
    <a href="/products/category/comics-manga" class="text-xs font-bold text-slate-400 hover:text-orange-500 transition flex items-center gap-1">
      ← BACK TO LIST
    </a>
    <h2 class="text-xs font-extrabold text-white tracking-wider"><%= title %></h2>
    <a href="/eslip/<%= mangaId %>" class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-black px-3 py-1.5 rounded-lg transition uppercase tracking-wider">
      BUY & GET E-SLIP
    </a>
  </header>

  <!-- Main Pages List Container -->
  <main class="max-w-3xl w-full mx-auto p-6 flex flex-col gap-4 my-4 flex-grow">
    
    <% pages.forEach((pageUrl, index) => { %>
      <!-- Page Card Component -->
      <div 
        @click="activeImage = '<%= pageUrl %>'; activePageNum = <%= index + 1 %>"
        class="bg-slate-900 border border-slate-800 hover:border-orange-500/80 rounded-2xl p-5 cursor-pointer transition-all duration-300 hover:shadow-2xl hover:-translate-y-0.5 flex items-center justify-between group"
      >
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 text-orange-400 font-black flex items-center justify-center text-sm">
            0<%= index + 1 %>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white group-hover:text-orange-400 transition">Page <%= index + 1 %></h3>
            <p class="text-[10px] text-slate-500">Click to view full manga panel</p>
          </div>
        </div>

        <button class="bg-slate-800 group-hover:bg-orange-500 text-slate-300 group-hover:text-white text-xs font-bold px-4 py-2 rounded-xl transition flex items-center gap-1">
          👁️ Open Page
        </button>
      </div>
    <% }); %>

    <div class="mt-6 text-center">
      <a href="/eslip/<%= mangaId %>" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-black text-xs px-8 py-3.5 rounded-xl uppercase tracking-wider shadow-lg transition">
        🛒 Buy Full Volume (Get E-Slip)
      </a>
    </div>

  </main>

  <!-- FULLSCREEN MANGA READER MODAL -->
  <div 
    x-show="activeImage" 
    x-cloak 
    class="fixed inset-0 z-50 bg-black/95 flex flex-col items-center justify-between p-4 backdrop-blur-md"
  >
    <!-- Modal Header -->
    <div class="w-full max-w-4xl flex justify-between items-center py-2 text-xs font-bold text-slate-400 border-b border-slate-800 mb-2">
      <span class="text-orange-400">READING PAGE <span x-text="activePageNum"></span></span>
      <button @click="activeImage = null" class="bg-slate-800 hover:bg-red-600 text-white px-3 py-1 rounded-lg transition text-xs font-black">
        ✕ CLOSE (ESC)
      </button>
    </div>

    <!-- Manga Image -->
    <div class="flex-grow flex items-center justify-center overflow-auto max-h-[85vh] w-full my-auto">
      <img :src="activeImage" alt="Manga Page" class="max-h-full max-w-full object-contain rounded-lg shadow-2xl border border-slate-800">
    </div>

    <!-- Modal Footer -->
    <div class="py-2">
      <button @click="activeImage = null" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold px-6 py-2 rounded-xl transition">
        Done Reading
      </button>
    </div>
  </div>

</body>
</html>